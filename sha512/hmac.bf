  [->>>>>>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<<<<<<]
>>>>>>>>>>>>>>>>>>>>>>>>>>>                                    ; p := 1
                                                               ; ASSERT ptr=1507
  +
> ++++++++                                                     ; cnt := 8
                                                               ; ASSERT ptr=1508
  [-                                                           ; ____ eight bit steps ____
  <<<<<<<<<<<< [->>>+<[-<+>>-<]>[-<+>]<<<]                     ; HALVE a  giving qa and pa
  >>>> [->>>+<[-<+>>-<]>[-<+>]<<<]                             ; HALVE b  giving qb and pb
  << [->>>>>>>+<[->-<]>[-<+>]<<<<<<<]                          ; low bit of a toggles t
  >>>> [->>>+<[->-<]>[-<+>]<<<]                                ; low bit of b toggles t
  >> [->>>[-<+>>>+<<]>>[-<<+>>]<<<<<]                          ; if t then res gets p
  <<<<<<< [-<+>]                                               ; a := qa
  >>>> [-<+>]                                                  ; b := qb
  >>>>>> [->>+<<]                                              ; p into tmp
  >> [-<<++>>]                                                 ; p := tmp doubled
  <                                                            ; back to cnt
  ]
                                                               ; ASSERT ptr=1508
<<                                                             ; res is stored as r0
  [-<<<<<<<<<<<<<<<<<<+>>>>>>>>>>>>>>>>>>]
<<<<<<<<<<<<<<<<<<                                             ; back to r0
                                                               ; ASSERT ptr=1488
                                                               ; ASSERT zero 1496:1509

; ============================================================ ; ; ; ; byte 1 : x1 @0x01  y1 @0x09  into r1 @0x11
<<<<<<<<<<<<<<<                                                ; x1 moves into a
  [->>>>>>>>>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<<<<<<<<<]
>>>>>>>>                                                       ; y1 moves into b
  [->>>>>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<<<<<]
>>>>>>>>>>>>>>>>>>>>>>>>>>                                     ; p := 1
                                                               ; ASSERT ptr=1507
  +
> ++++++++                                                     ; cnt := 8
                                                               ; ASSERT ptr=1508
  [-                                                           ; ____ eight bit steps ____
  <<<<<<<<<<<< [->>>+<[-<+>>-<]>[-<+>]<<<]                     ; HALVE a  giving qa and pa
  >>>> [->>>+<[-<+>>-<]>[-<+>]<<<]                             ; HALVE b  giving qb and pb
  << [->>>>>>>+<[->-<]>[-<+>]<<<<<<<]                          ; low bit of a toggles t
  >>>> [->>>+<[->-<]>[-<+>]<<<]                                ; low bit of b toggles t
  >> [->>>[-<+>>>+<<]>>[-<<+>>]<<<<<]                          ; if t then res gets p
  <<<<<<< [-<+>]                                               ; a := qa
  >>>> [-<+>]                                                  ; b := qb
  >>>>>> [->>+<<]                                              ; p into tmp
  >> [-<<++>>]                                                 ; p := tmp doubled
  <                                                            ; back to cnt
  ]
                                                               ; ASSERT ptr=1508
<<                                                             ; res is stored as r1
  [-<<<<<<<<<<<<<<<<<+>>>>>>>>>>>>>>>>>]
<<<<<<<<<<<<<<<<<<                                             ; back to r0
                                                               ; ASSERT ptr=1488
                                                               ; ASSERT zero 1496:1509

