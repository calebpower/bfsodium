>>>>>>>>                                                       ; move b0 into the addend
  [->>>>>>>>>>+<<<<<<<<<<]
>>>>>>>>>                                                      ; to the kernel base  which is where a paste site
                                                               ; always stands
                                                               ; ASSERT ptr=1281
  >                                                            ; walk in to this routine entry offset
