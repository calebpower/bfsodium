                                                               ; consumes what it reads
                                                               ; ASSERT ptr=1288
  [->>+>+<<<]
>>>                                                            ; the spare hands it straight back
                                                               ; ASSERT ptr=1291
  [-<<<+>>>]
<<                                                             ; the low bit sum is copied the same way
                                                               ; ASSERT ptr=1289
  [-<<<+>>>>>+<<]
>>
  [-<<+>>]
