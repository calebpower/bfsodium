  [-R72+L72] R1
  [-R72+L72] R1
  [-R72+L72] R1
  [-R72+L72] R1
  [-R72+L72] R1
  [-R72+L72] R1
  [-R72+L72]
R57
; ASSERT ptr=112
@@XOR64@@ 112
; ASSERT ptr=112
; the result comes back as the sigma0 accumulator
R16
  [-L72+R72] R1
  [-L72+R72] R1
  [-L72+R72] R1
  [-L72+R72] R1
  [-L72+R72] R1
  [-L72+R72] R1
  [-L72+R72] R1
  [-L72+R72]
