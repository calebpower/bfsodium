  [-R168+L168] R1
  [-R168+L168] R1
  [-R168+L168] R1
  [-R168+L168] R1
  [-R168+L168] R1
  [-R168+L168] R1
  [-R168+L168]
; to the shift count
R169
; ASSERT ptr=184
  +++++++
L8
; ASSERT ptr=176
@@SHR64@@ 176
; ASSERT ptr=176
; the shifted word comes back as s1
  [-L136+R136] R1
  [-L136+R136] R1
  [-L136+R136] R1
  [-L136+R136] R1
  [-L136+R136] R1
  [-L136+R136] R1
  [-L136+R136] R1
  [-L136+R136]
; the two rotations so far step down into s2
L127
  [-L8+R8] R1
  [-L8+R8] R1
  [-L8+R8] R1
  [-L8+R8] R1
  [-L8+R8] R1
  [-L8+R8] R1
  [-L8+R8] R1
  [-L8+R8]
; and the last exclusive or  s2 first
L15
; ASSERT ptr=48
  [-R64+L64] R1
  [-R64+L64] R1
  [-R64+L64] R1
  [-R64+L64] R1
  [-R64+L64] R1
  [-R64+L64] R1
  [-R64+L64] R1
  [-R64+L64]
; then s1
L15
; ASSERT ptr=40
  [-R80+L80] R1
  [-R80+L80] R1
  [-R80+L80] R1
  [-R80+L80] R1
  [-R80+L80] R1
  [-R80+L80] R1
  [-R80+L80] R1
  [-R80+L80]
R65
; ASSERT ptr=112
@@XOR64@@ 112
; ASSERT ptr=112
; and sigma0 is done
R16
  [-L72+R72] R1
  [-L72+R72] R1
  [-L72+R72] R1
  [-L72+R72] R1
  [-L72+R72] R1
  [-L72+R72] R1
  [-L72+R72] R1
  [-L72+R72]

; ==== sigma1 of W{t minus 2} ====
