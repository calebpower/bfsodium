  >> [-<<++>>]                                                 ; p := tmp doubled
  <                                                            ; back to cnt
  ]
  << [-<<<<<<<<<<<<<<+>>>>>>>>>>>>>>]                          ; store res into r0
  <<<<<<<<<<<<<<                                               ; back to r0

