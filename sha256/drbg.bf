  >>>>>> [->>+<<]                                              ; p into tmp
  >> [-<<++>>]                                                 ; p := tmp doubled
  <                                                            ; back to cnt
  ]
  << [-<<<<<<<<<<<<+>>>>>>>>>>>>]                              ; store res into r2
  <<<<<<<<<<<<<<                                               ; back to r0

