  <                                                            ; back to cnt
  ]
  << [-<<<<<<<<<<<<+>>>>>>>>>>>>]                              ; store res into r2
  <<<<<<<<<<<<<<                                               ; back to r0

; ============================================================ ; ; ; ; ; byte 3 : x3 @0x03  y3 @0x07  into r3 @0x0b
