                                                               ; ASSERT ptr=1781
<                                                              ; the carry in is nought or one  so it takes the old
  [->>+<<]                                                     ; ; kernel
>>
                                                               ; ASSERT ptr=1782
  [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]
<                                                              ; store the sum back into a0
  [-<<<<<<<<<+>>>>>>>>>]
>>                                                             ; the carry out becomes the carry in for the next byte
  [-<<<+>>>]
<<<                                                            ; back to the carry in
                                                               ; ASSERT ptr=1780
                                                               ; ASSERT zero 1781:1791

