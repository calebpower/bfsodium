  >>>>>>>>>>>>>>>>>>>>>>>>>]                                   ; continued
<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<                                ; the accumulator into the adder
  [->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<
  <<<<<<<<<<<<<<<<<<<<<<<<<]                                   ; continued
>
  [->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<
  <<<<<<<<<<<<<<<<<<<<<<<<<]                                   ; continued
>
  [->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<
  <<<<<<<<<<<<<<<<<<<<<<<<<]                                   ; continued
>
  [->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<
  <<<<<<<<<<<<<<<<<<<<<<<<<]                                   ; continued
>>>>>>>>>>>>>                                                  ; and the addend after it
  [->>>>>>>>>>>>>>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<<<<<<<<<<<<<
  <]                                                           ; continued
>
  [->>>>>>>>>>>>>>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<<<<<<<<<<<<<
  <]                                                           ; continued
>
  [->>>>>>>>>>>>>>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<<<<<<<<<<<<<
  <]                                                           ; continued
>
  [->>>>>>>>>>>>>>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<<<<<<<<<<<<<
  <]                                                           ; continued
