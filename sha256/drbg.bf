                                                               ; loop touched is back where it started;
                                                               ; ASSERT zero 1848:1857
                                                               ; ASSERT zero 1859:1859
<<                                                             ; store res into r0
                                                               ; ASSERT ptr=1858
  [-<<<<<<<<<<<<<<+>>>>>>>>>>>>>>]
<<<<<<<<<<<<<<                                                 ; back to the head of the result
                                                               ; ASSERT ptr=1844

