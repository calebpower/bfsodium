; ==== the message length  read first and kept for the last block ====
; A bfsodium primitive never relies on end of input  so the length comes
; first; it is kept because the final block carries it as a bit count;
>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>   ; continued
  >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>   ; continued
  >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>   ; continued
  >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>   ; continued
  >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>   ; continued
  >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>   ; continued
  >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>   ; continued
  >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>   ; continued
  >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>   ; continued
  >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>   ; continued
  >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>   ; continued
  >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>   ; continued
  >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>                ; continued
; ASSERT ptr=832
  ,>,
<                                                              ; the length is copied  the count gets spent
  [->>>>>>>>>>>>+<<<<+<<<<<<<<]
>>>>>>>>
  [-<<<<<<<<+>>>>>>>>]
<<<<<<<                                                        ; the length is copied  the count gets spent
  [->>>>>>>>>>>>+<<<<<+<<<<<<<]
>>>>>>>
  [-<<<<<<<+>>>>>>>]
<<<<<<                                                         ; the ONE that ends the message still needs placing
  [-]
  +
>>                                                             ; and there is at least one block to do
  [-]
  +

; ==== one turn is one padded block ====
[
>                                                              ; fifty six bytes  which is as far as a length can be
                                                               ; added after
  [-]
  ++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[
  -
; the block slides down BEFORE the byte lands  not after; sliding after
; would shift the first byte one place too far and it would fall out
; of the bottom  where the next byte would then land on top of it;
; every byte slides down one place
<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
  <<<<<<<<                                                     ; continued
  [-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-
  <+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+   ; continued
  >]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]   ; continued
  >[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[   ; continued
  -<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<   ; continued
  +>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>   ; continued
  ]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>   ; continued
  [-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]                           ; continued
>>>>>>>                                                        ; is there another message byte
  [-]
<<<<<<                                                         ; the low byte is copied out and handed straight back
  [->>>>>>>>+>+<<<<<<<<<]
>>>>>>>>>
  [-<<<<<<<<<+>>>>>>>>>]
<                                                              ; and a byte that is not nought raises the flag
  [[-]<<[-]+>>]
<<<<<<<                                                        ; the high byte is copied out and handed straight back
  [->>>>>>>+>+<<<<<<<<]
>>>>>>>>
  [-<<<<<<<<+>>>>>>>>]
<                                                              ; and a byte that is not nought raises the flag
  [[-]<<[-]+>>]
<<
>                                                              ; the else arm is armed  and taking a byte disarms it
  [-]
  +
<
[
  -
<<<<<<<                                                        ; a message byte lands on the top of the block
  ,
>>>>>>>>                                                       ; disarm the else
  -
<<<<<<<                                                        ; the low byte survives being looked at
