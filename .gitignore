# Compiled tools — the sources of truth are the .c files in tools/
/tools/bfi
/tools/hx
/tools/bflint
/tools/bfstyle
/tools/bffoot

# Build cruft
*.o
*.out

# tools/rebuild.sh expands each skeleton to "$out.new" and only then moves it
# over the committed file, so a rebuild that is interrupted leaves one behind.
# One was, and "git add -A" committed it as an empty file -- which no tier
# could see, because every glob in the suite is "*/*.bf" and this is not.
*.bf.new

# reaper run artifacts collected back from the guest
/out/
