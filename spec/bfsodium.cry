// bfsodium reference oracle (Cryptol).
//
// This is oracle B: a bit-precise, independent specification the brainfuck is
// checked against, byte-for-byte, alongside the published standard vectors
// (oracle A). Each `*Run` function takes and returns the exact wire bytes a
// bfsodium primitive reads on stdin and writes on stdout, so the driver can
// compare raw byte sequences with no marshaling of its own. The little-endian
// word handling lives here on purpose: it means the tests also prove the
// brainfuck's LE handling matches the spec.

module bfsodium where

// Little-endian conversion for a number of any byte width. Poly1305 works on
// 130-bit values, which are 17 bytes on the wire, so the 32-bit helpers below
// are not enough on their own.
leN : {n} (fin n) => [n][8] -> [n * 8]
leN bs = join (reverse bs)

leBytesN : {n} (fin n) => [n * 8] -> [n][8]
leBytesN w = reverse (split w)

// ADDN: in = a(n LE) # b(n LE); out = (a + b mod 2^(8n))(n LE).
// Exercised at 17 bytes, the width the Poly1305 accumulator needs.
add136Run : [34][8] -> [17][8]
add136Run inb = leBytesN`{17} (leN (take`{17} inb) + leN (drop`{17} inb))

// HALVEN: in = x(17 LE); out = (x >> 1)(17 LE).
halve136Run : [17][8] -> [17][8]
halve136Run inb = leBytesN`{17} (leN inb >> 1)

// FOLD: one reduction step using 2^130 = 5 (mod 2^130 - 5).
// in = x(17 LE); out = (L + 5H)(17 LE) where x = L + H*2^130.
fold136Run : [17][8] -> [17][8]
fold136Run inb = leBytesN`{17} (lo + 5 * hi)
  where
    x  = leN inb
    hi = x >> 130
    lo = x && ((1 << 130) - 1)

// REDUCEP: in = x(17 LE); out = (x mod p)(17 LE) where p = 2^130 - 5.
reducep136Run : [17][8] -> [17][8]
reducep136Run inb = leBytesN`{17} (leN inb % ((1 << 130) - 5))

// MULMOD: in = a(17 LE) # r(17 LE); out = (a * r mod p)(17 LE), p = 2^130 - 5.
// Computed in a wider type so the product is not truncated before reduction.
mulmod136Run : [34][8] -> [17][8]
mulmod136Run inb = leBytesN`{17} (drop`{136} prod)
  where
    a    = (zero # leN (take`{17} inb)) : [272]
    r    = (zero # leN (drop`{17} inb)) : [272]
    pp   = ((1 : [272]) << 130) - 5
    prod = (a * r) % pp

// A 32-bit word is four little-endian bytes on the wire (LSB first).
leWord : [4][8] -> [32]
leWord bs = join (reverse bs)

leBytes : [32] -> [4][8]
leBytes w = reverse (split w)

// ADD32: in = a(4 LE) # b(4 LE); out = (a + b mod 2^32)(4 LE).
add32Run : [8][8] -> [4][8]
add32Run inb = leBytes (leWord (take`{4} inb) + leWord (drop`{4} inb))

// ROTL32 by n: in = w(4 LE); out = (w <<< n)(4 LE).
rotl32Run : [8] -> [4][8] -> [4][8]
rotl32Run n inb = leBytes (leWord inb <<< n)

// ROTL32 with the rotation count supplied on the wire, as chacha20/rotl32.bf
// reads it: in = w(4 LE) # n(1); out = (w <<< n)(4 LE).
rotl32nRun : [5][8] -> [4][8]
rotl32nRun inb = leBytes (leWord (take`{4} inb) <<< (inb @ 4))

// XOR32: in = x(4 LE) # y(4 LE); out = (x ^ y)(4 LE).
xor32Run : [8][8] -> [4][8]
xor32Run inb = leBytes (leWord (take`{4} inb) ^ leWord (drop`{4} inb))

// The quarter round on four words.
qr4 : ([32],[32],[32],[32]) -> ([32],[32],[32],[32])
qr4 (a,b,c,d) = (a2,b2,c2,d2)
  where
    a1 = a  + b
    d1 = (d  ^ a1) <<< 16
    c1 = c  + d1
    b1 = (b  ^ c1) <<< 12
    a2 = a1 + b1
    d2 = (d1 ^ a2) <<< 8
    c2 = c1 + d2
    b2 = (b1 ^ c2) <<< 7

applyQR : [16][32] -> ([8],[8],[8],[8]) -> [16][32]
applyQR s (i,j,k,l) =
    update (update (update (update s i a') j b') k c') l d'
  where (a',b',c',d') = qr4 (s@i, s@j, s@k, s@l)

doubleRound : [16][32] -> [16][32]
doubleRound s = foldl applyQR s
    [ (0,4,8,12), (1,5,9,13), (2,6,10,14), (3,7,11,15)
    , (0,5,10,15),(1,6,11,12),(2,7,8,13), (3,4,9,14) ]

// The ChaCha20 block function (RFC 8439 section 2.3), taking and returning the
// exact wire bytes chacha20/block.bf reads and writes:
// in = key(32) # counter(4 LE) # nonce(12); out = the 64 byte keystream block.
blockRun : [48][8] -> [64][8]
blockRun inb = chachaBlock (take`{32} inb) (leWord (take`{4} (drop`{32} inb)))
                           (drop`{36} inb)

// The block function proper, on parts rather than wire bytes, so the stream
// cipher can call it once per 64 byte block.
chachaBlock : [32][8] -> [32] -> [12][8] -> [64][8]
chachaBlock key ctr non = join [ leBytes w | w <- out ]
  where
    kws  = [ leWord w | w <- split`{8} key ]
    nws  = [ leWord w | w <- split`{3} non ]
    st0  = [0x61707865, 0x3320646e, 0x79622d32, 0x6b206574] # kws # [ctr] # nws
    sts  = [st0] # [ doubleRound s | s <- sts ]
    out  = [ x + y | x <- sts @ (10 : [8]) | y <- st0 ]

// The ChaCha20 stream cipher (RFC 8439 section 2.4), taking and returning the
// exact wire bytes chacha20/stream.bf reads and writes:
//   in  = key(32) # counter(4 LE) # nonce(12) # len(2 LE) # plaintext(len)
//   out = ciphertext(len)
// The length prefix is what the brainfuck uses to know when to stop, since a
// primitive here never relies on end of input (CONVENTIONS section 7).
streamRun : {n} (fin n, 64 >= width n) => [50 + n][8] -> [n][8]
streamRun inb = [ p ^ k | p <- ptext | k <- ks ]
  where
    key   = take`{32} inb
    ctr   = leWord (take`{4} (drop`{32} inb))
    non   = take`{12} (drop`{36} inb)
    ptext = drop`{50} inb
    ks    = take`{n} (join [ chachaBlock key (ctr + i) non
                           | i <- [0 ...] : [_][32] ])

// The ChaCha20 quarter round (RFC 8439 section 2.2.1).
// in = a # b # c # d, each 4 LE bytes; out = the same four words, updated.
qrRun : [16][8] -> [16][8]
qrRun inb = leBytes a2 # leBytes b2 # leBytes c2 # leBytes d2
  where
    ws = [ leWord w | w <- split`{4} inb ]
    a  = ws @ (0 : [8])
    b  = ws @ (1 : [8])
    c  = ws @ (2 : [8])
    d  = ws @ (3 : [8])
    a1 = a  + b
    d1 = (d  ^ a1) <<< 16
    c1 = c  + d1
    b1 = (b  ^ c1) <<< 12
    a2 = a1 + b1
    d2 = (d1 ^ a2) <<< 8
    c2 = c1 + d2
    b2 = (b1 ^ c2) <<< 7

// Poly1305 (RFC 8439 section 2.5) over a 34 byte message, which is the size of
// the section 2.5.2 vector: two full blocks and a two byte tail.
//   in = key(32) # len(2 LE) # msg(34); out = tag(16)
// Written out block by block rather than folded, so it stays readable and
// stays independent of how the brainfuck loops.
wide : {k} (fin k, 272 >= k) => [k] -> [272]
wide x = zero # x

poly1305Run34 : [68][8] -> [16][8]
poly1305Run34 inb = leBytesN`{16} (drop`{144} ((a2 + s) && ((1 << 128) - 1)))
  where
    key = take`{32} inb
    msg = drop`{34} inb
    r   = wide (leN (take`{16} key) && 0x0ffffffc0ffffffc0ffffffc0fffffff)
    s   = wide (leN (drop`{16} key))
    pp  = ((1 : [272]) << 130) - 5
    b0  = wide (leN (take`{16} msg))              + (1 << 128)
    b1  = wide (leN (take`{16} (drop`{16} msg)))  + (1 << 128)
    b2  = wide (leN (drop`{32} msg))              + (1 << 16)
    a0  = ((0  + b0) * r) % pp
    a1  = ((a0 + b1) * r) % pp
    a2  = ((a1 + b2) * r) % pp

// ROWROT: rotate each of the four rows of a ChaCha state left by one word.
// This is what makes every column quarter round land on the same four words,
// so the block function needs no indexed access.
rowrotRun : [64][8] -> [64][8]
rowrotRun inb = join [ join [ leBytes w | w <- (r <<< 1) ]
                     | r <- split`{4} [ leWord w | w <- split`{16} inb ] ]

// STAGGER: rotate row r left by r. This is what turns the diagonal round into
// another column round. Applying it four times is the identity, which is how
// the block function undoes it.
staggerRun : [64][8] -> [64][8]
staggerRun inb = join [ join [ leBytes w | w <- (r <<< n) ]
                      | r <- split`{4} [ leWord w | w <- split`{16} inb ]
                      | n <- [0,1,2,3] : [4][8] ]

// One double round applied to the state built from the block function's input,
// so the brainfuck can be checked a round at a time rather than only at the end.
oneDblRun : [48][8] -> [64][8]
oneDblRun inb = join [ leBytes w | w <- doubleRound st0 ]
  where
    kws = [ leWord w | w <- split`{8} (take`{32} inb) ]
    cw  = leWord (take`{4} (drop`{32} inb))
    nws = [ leWord w | w <- split`{3} (drop`{36} inb) ]
    st0 = [0x61707865, 0x3320646e, 0x79622d32, 0x6b206574] # kws # [cw] # nws

// Shift left one, the mirror of halve136Run. The bit leaving the top byte is
// dropped, which is what makes this a doubling modulo 2^136 rather than a
// widening one; mulmod136 only ever doubles values already under 2^131, so the
// bit that is dropped is always nought.
dbl136Run : [17][8] -> [17][8]
dbl136Run inb = leBytesN`{17} (leN inb << 1)

// ---------------------------------------------------------------------------
// Poly1305 for message lengths other than the RFC's 34 bytes.
//
// poly1305Run34 above stays as it is: it spells its three blocks out longhand,
// so it is an independent second formulation of the same thing rather than a
// re-export of what follows.
//
// A block is its bytes little endian with a ONE appended after them, so a full
// block carries 2^128 and a tail of m bytes carries 2^(8m). Getting that
// boundary wrong is the classic Poly1305 defect, which is why the lengths
// tested below straddle it.

polyBlock : {m} (fin m, m <= 16) => [m][8] -> [272]
polyBlock b = wide (leN b) + ((1 : [272]) << (8 * `m))

polyCore : {nb} (fin nb) => [32][8] -> [nb][272] -> [16][8]
polyCore key ns = leBytesN`{16} (drop`{144} ((acc + s) && ((1 << 128) - 1)))
  where
    r    = wide (leN (take`{16} key) && 0x0ffffffc0ffffffc0ffffffc0fffffff)
    s    = wide (leN (drop`{16} key))
    pp   = ((1 : [272]) << 130) - 5
    accs = [0] # [ ((a + n) * r) % pp | a <- accs | n <- ns ]
    acc  = last accs

// One byte: a single block whose one sits at 2^8.
poly1305Run1 : [35][8] -> [16][8]
poly1305Run1 inb = polyCore (take`{32} inb) [polyBlock`{1} (drop`{34} inb)]

// Exactly one full block: the one sits at 2^128 and no second block exists.
poly1305Run16 : [50][8] -> [16][8]
poly1305Run16 inb = polyCore (take`{32} inb) [polyBlock`{16} (drop`{34} inb)]

// One byte past a full block: the first block's one is at 2^128 and the
// second's at 2^8.
poly1305Run17 : [51][8] -> [16][8]
poly1305Run17 inb = polyCore (take`{32} inb)
                             [ polyBlock`{16} (take`{16} (drop`{34} inb))
                             , polyBlock`{1}  (drop`{50} inb) ]

// Two full blocks.
poly1305Run32 : [66][8] -> [16][8]
poly1305Run32 inb = polyCore (take`{32} inb)
                             [ polyBlock`{16} (take`{16} (drop`{34} inb))
                             , polyBlock`{16} (drop`{50} inb) ]

// The RFC's own length, built the general way. poly1305Run34 spells the same
// three blocks out longhand, so if the two ever disagree one of them is wrong;
// an oracle that is only ever compared against itself proves nothing.
poly1305Run34g : [68][8] -> [16][8]
poly1305Run34g inb = polyCore (take`{32} inb)
                              [ polyBlock`{16} (take`{16} (drop`{34} inb))
                              , polyBlock`{16} (take`{16} (drop`{50} inb))
                              , polyBlock`{2}  (drop`{66} inb) ]

longhand_agrees_with_general : [68][8] -> Bit
property longhand_agrees_with_general inb = poly1305Run34 inb == poly1305Run34g inb

// ---------------------------------------------------------------------------
// ABSORB: the one step every Poly1305 block takes, lifted out of poly1305 so
// the AEAD can take it too. Shipped as poly1305/absorb.bf.
//   in  = r(17 LE) # acc(17 LE) # blk(17 LE)
//   out = acc(17 LE)
// The addition is the seventeen byte one add136 performs, so it wraps at 2^136
// rather than reducing; the reduction to below p is mulmod136's, afterwards.
absorbRun : [51][8] -> [17][8]
absorbRun inb = leBytesN`{17} (drop`{136} ((tot * r) % pp))
  where
    r   = (zero # leN (take`{17} inb))              : [272]
    acc = (zero # leN (take`{17} (drop`{17} inb)))  : [272]
    blk = (zero # leN (drop`{34} inb))              : [272]
    pp  = ((1 : [272]) << 130) - 5
    tot = (acc + blk) % (1 << 136)

// The new oracle tied back to the published one. absorbRun could be wrong in
// exactly the way the brainfuck is wrong and the two would still agree, so it
// is also required to reproduce the RFC section 2.5.2 tag by a different route:
// fold it over the three blocks of that message and finish the tag as the RFC
// does. poly1305Run34 spells the same computation out longhand and neither is
// built from the other.
absorb_folds_to_the_rfc_tag : [68][8] -> Bit
property absorb_folds_to_the_rfc_tag inb = tag == poly1305Run34 inb
  where
    key  = take`{32} inb
    msg  = drop`{34} inb
    r17  = leBytesN`{17}
             ((zero # (leN (take`{16} key) && 0x0ffffffc0ffffffc0ffffffc0fffffff)) : [136])
    b0   = leBytesN`{17} (((zero # leN (take`{16} msg))             + (1 << 128)) : [136])
    b1   = leBytesN`{17} (((zero # leN (take`{16} (drop`{16} msg))) + (1 << 128)) : [136])
    b2   = leBytesN`{17} (((zero # leN (drop`{32} msg))             + (1 <<  16)) : [136])
    a0   = absorbRun (r17 # leBytesN`{17} (zero : [136]) # b0)
    a1   = absorbRun (r17 # a0 # b1)
    a2   = absorbRun (r17 # a1 # b2)
    s    = (zero # leN (drop`{16} key)) : [136]
    tag  = leBytesN`{16} (drop`{8} ((leN a2 + s) : [136]))

// KEYGEN: the Poly1305 one time key (RFC 8439 section 2.6). It is the first
// half of the block the counter NOUGHT produces; the AEAD encrypts from
// counter one, so the block this consumes is never reused as keystream.
//   in  = key(32) # nonce(12)
//   out = otk(32)
keygenRun : [44][8] -> [32][8]
keygenRun inb = take`{32} (chachaBlock (take`{32} inb) 0 (drop`{32} inb))

// CLAMP: r as RFC 8439 section 2.5 requires it. Bytes 3 7 11 and 15 keep only
// their low four bits and bytes 4 8 and 12 lose their low two. Stated here as
// the mask the RFC states, which is independent of the repeated halving the
// brainfuck uses to achieve it -- brainfuck has no AND.
//   in = r(16); out = r(17 LE), the seventeenth byte always nought
clampRun : [16][8] -> [17][8]
clampRun inb =
    leBytesN`{17} ((zero # (leN inb && 0x0ffffffc0ffffffc0ffffffc0fffffff)) : [136])

// BLOCKKEEP: the ChaCha20 block, with the forty eight bytes it was made from
// still intact afterwards. blockloop consumes them, which is right for a
// routine called once and wrong for a stream; this is the form the AEAD and
// any multi block caller wants.
//   in  = key(32) # ctr(4 LE) # nonce(12)
//   out = keystream(64) # the same forty eight bytes
blockkeepRun : [48][8] -> [112][8]
blockkeepRun inb = blockRun inb # inb

// ---------------------------------------------------------------------------
// ChaCha20-Poly1305 AEAD (RFC 8439 section 2.8), taking and returning the exact
// wire bytes aead/chacha20poly1305.bf reads and writes:
//   in  = key(32) # nonce(12) # alen(2 LE) # aad # plen(2 LE) # pt
//   out = ciphertext # tag(16)
//
// Written out per length rather than once polymorphically, exactly as the
// Poly1305 oracles above are. The padding and the block count are type level
// facts, and spelling each case out keeps the oracle readable and keeps it
// independent of how the brainfuck loops -- which is the whole job of oracle B.
//
// The one time key comes from counter NOUGHT and the keystream from counter
// one onward, so the block that made the key is never reused. The tag is taken
// over the ciphertext, never the plaintext.

aeadRun_0_0 : [48][8] -> [16][8]
aeadRun_0_0 inb = polyCore otk [ polyBlock`{16} b | b <- split`{1} macd ]
  where
    key  = take`{32} inb
    non  = take`{12} (drop`{32} inb)
    otk  = take`{32} (chachaBlock key 0 non)
    macd = leBytesN`{8} (0 : [64]) # leBytesN`{8} (0 : [64])

aeadRun_0_1 : [49][8] -> [17][8]
aeadRun_0_1 inb = ct # tag
  where
    key  = take`{32} inb
    non  = take`{12} (drop`{32} inb)
    pt   = drop`{48} inb
    otk  = take`{32} (chachaBlock key 0 non)
    ct   = [ x ^ y | x <- pt | y <- take`{1} (chachaBlock key 1 non) ]
    macd = ct # (zero : [15][8])
           # leBytesN`{8} (0 : [64]) # leBytesN`{8} (1 : [64])
    tag  = polyCore otk [ polyBlock`{16} b | b <- split`{2} macd ]

aeadRun_16_16 : [80][8] -> [32][8]
aeadRun_16_16 inb = ct # tag
  where
    key  = take`{32} inb
    non  = take`{12} (drop`{32} inb)
    aad  = take`{16} (drop`{46} inb)
    pt   = drop`{64} inb
    otk  = take`{32} (chachaBlock key 0 non)
    ct   = [ x ^ y | x <- pt | y <- take`{16} (chachaBlock key 1 non) ]
    macd = aad # ct
           # leBytesN`{8} (16 : [64]) # leBytesN`{8} (16 : [64])
    tag  = polyCore otk [ polyBlock`{16} b | b <- split`{3} macd ]

aeadRun_0_64 : [112][8] -> [80][8]
aeadRun_0_64 inb = ct # tag
  where
    key  = take`{32} inb
    non  = take`{12} (drop`{32} inb)
    pt   = drop`{48} inb
    otk  = take`{32} (chachaBlock key 0 non)
    ct   = [ x ^ y | x <- pt | y <- chachaBlock key 1 non ]
    macd = ct # leBytesN`{8} (0 : [64]) # leBytesN`{8} (64 : [64])
    tag  = polyCore otk [ polyBlock`{16} b | b <- split`{5} macd ]

aeadRun_0_65 : [113][8] -> [81][8]
aeadRun_0_65 inb = ct # tag
  where
    key  = take`{32} inb
    non  = take`{12} (drop`{32} inb)
    pt   = drop`{48} inb
    otk  = take`{32} (chachaBlock key 0 non)
    ct   = [ x ^ y | x <- pt
                   | y <- take`{65} (chachaBlock key 1 non # chachaBlock key 2 non) ]
    macd = ct # (zero : [15][8])
           # leBytesN`{8} (0 : [64]) # leBytesN`{8} (65 : [64])
    tag  = polyCore otk [ polyBlock`{16} b | b <- split`{6} macd ]

aeadRun_12_114 : [174][8] -> [130][8]
aeadRun_12_114 inb = ct # tag
  where
    key  = take`{32} inb
    non  = take`{12} (drop`{32} inb)
    aad  = take`{12} (drop`{46} inb)
    pt   = drop`{60} inb
    otk  = take`{32} (chachaBlock key 0 non)
    ct   = [ x ^ y | x <- pt
                   | y <- take`{114} (chachaBlock key 1 non # chachaBlock key 2 non) ]
    macd = aad # (zero : [4][8]) # ct # (zero : [14][8])
           # leBytesN`{8} (12 : [64]) # leBytesN`{8} (114 : [64])
    tag  = polyCore otk [ polyBlock`{16} b | b <- split`{10} macd ]

// ADD8: the carry detecting adder every wide adder in the library is built
// from. Shipped as idiom/add8.bf.
//   in  = x(1) # y(1)
//   out = sum(1) # carry(1)
add8Run : [2][8] -> [2][8]
add8Run inb = [ x + y, take`{8} wide ]
  where
    x    = inb @ (0 : [8])
    y    = inb @ (1 : [8])
    wide = ((zero # x) : [16]) + (zero # y)

// AND32: in = x(4 LE) # y(4 LE); out = (x AND y)(4 LE).
// brainfuck has no bitwise instruction, so idiom/and32 decomposes both bytes a
// bit at a time; the spec says what it must come to, not how.
and32Run : [8][8] -> [4][8]
and32Run inb = leBytes (leWord (take`{4} inb) && leWord (drop`{4} inb))

// ROTR32 with the count on the wire, as idiom/rotr32.bf reads it:
// in = w(4 LE) # n(1); out = (w rotated right by n)(4 LE).
rotr32nRun : [5][8] -> [4][8]
rotr32nRun inb = leBytes (leWord (take`{4} inb) >>> (inb @ 4))

// A 64-bit word is eight little-endian bytes on the wire (LSB first). The
// 32-bit pair above is kept beside this rather than generalised away,
// because every call site reads better named than parameterised.
leWord64 : [8][8] -> [64]
leWord64 bs = join (reverse bs)

leBytes64 : [64] -> [8][8]
leBytes64 w = reverse (split w)

// ROTR64 with the count on the wire, as idiom/rotr64.bf reads it:
// in = w(8 LE) # n(1); out = (w rotated right by n)(8 LE). The 64-bit
// widening of rotr32, and the piece SHA-512 and Keccak both need.
rotr64nRun : [9][8] -> [8][8]
rotr64nRun inb = leBytes64 (leWord64 (take`{8} inb) >>> (inb @ 8))

// ROTL64 with the count on the wire: in = w(8 LE) # n(1);
// out = (w rotated left by n)(8 LE). One operator apart from rotr64nRun, and
// the implementation underneath is not: idiom/rotl64.bf never shifts left,
// because a left shift is a doubling and a doubling is an addition. It turns
// whole bytes and then pastes rotr64 for the one to eight bits left over.
// Keccak's rho step is twenty five of these a round.
rotl64nRun : [9][8] -> [8][8]
rotl64nRun inb = leBytes64 (leWord64 (take`{8} inb) <<< (inb @ 8))

// SHR32 with the count on the wire: in = w(4 LE) # n(1);
// out = (w shifted right by n)(4 LE). The bits that fall out are gone, which
// is the only thing separating this from rotr32.
shr32nRun : [5][8] -> [4][8]
shr32nRun inb = leBytes (leWord (take`{4} inb) >> (inb @ 4))

// SHR64 with the count on the wire: in = w(8 LE) # n(1);
// out = (w shifted right by n)(8 LE). One operator apart from rotr64nRun,
// exactly as idiom/shr64.bf is one line apart from idiom/rotr64.bf, and
// SHA-512's sigma functions need both.
shr64nRun : [9][8] -> [8][8]
shr64nRun inb = leBytes64 (leWord64 (take`{8} inb) >> (inb @ 8))

// ==== Keccak-f[1600], FIPS 202 ====
//
// The state is 200 bytes read as twenty five 64-bit little endian lanes, and
// lane k is the lane FIPS 202 calls A[x][y] with k = 5y + x. So a ROW is five
// consecutive lanes and a COLUMN is five lanes forty bytes apart, which is the
// whole reason keccak/theta.bf carries its operands to a frame.
keccakLanes : [200][8] -> [25][64]
keccakLanes bs = [ leWord64 l | l <- split`{25} bs ]

keccakBytes : [25][64] -> [200][8]
keccakBytes ls = join [ leBytes64 l | l <- ls ]

// THETA, section 3.2.1. The five column sums, the two neighbours each column
// contributes to, and then every lane takes its own column's contribution.
// Both index arithmetics are written out rather than taken modulo five, so
// this reads the same way the five blocks of keccak/theta.skel do.
keccakThetaC : [25][64] -> [5][64]
keccakThetaC a =
  [ a@0 ^ a@5 ^ a@10 ^ a@15 ^ a@20
  , a@1 ^ a@6 ^ a@11 ^ a@16 ^ a@21
  , a@2 ^ a@7 ^ a@12 ^ a@17 ^ a@22
  , a@3 ^ a@8 ^ a@13 ^ a@18 ^ a@23
  , a@4 ^ a@9 ^ a@14 ^ a@19 ^ a@24 ]

keccakThetaD : [5][64] -> [5][64]
keccakThetaD c =
  [ c@4 ^ (c@1 <<< 1)
  , c@0 ^ (c@2 <<< 1)
  , c@1 ^ (c@3 <<< 1)
  , c@2 ^ (c@4 <<< 1)
  , c@3 ^ (c@0 <<< 1) ]

keccakTheta : [25][64] -> [25][64]
keccakTheta a = [ (a@k) ^ (d@(k % 5)) | k <- [0 .. 24] ]
  where d = keccakThetaD (keccakThetaC a)

// in = A(200); out = A(200) with theta applied.
keccakThetaRun : [200][8] -> [200][8]
keccakThetaRun inb = keccakBytes (keccakTheta (keccakLanes inb))

// RHO and PI, sections 3.2.2 and 3.2.3, as ONE table. rho turns the lane at
// 5y+x left by the offset FIPS 202 gives it and pi sends that lane to
// 5*((2x+3y) mod 5) + y, so the two together are twenty five (source,
// rotation) pairs. The list below is ordered by DESTINATION, which is the
// order keccak/rhopichi.skel is written in and the order that lets rotl64 be
// pasted at the destination lane.
keccakRhoPi : [25][64] -> [25][64]
keccakRhoPi a =
  [ a@0  <<< 0,  a@6  <<< 44, a@12 <<< 43, a@18 <<< 21, a@24 <<< 14
  , a@3  <<< 28, a@9  <<< 20, a@10 <<< 3,  a@16 <<< 45, a@22 <<< 61
  , a@1  <<< 1,  a@7  <<< 6,  a@13 <<< 25, a@19 <<< 8,  a@20 <<< 18
  , a@4  <<< 27, a@5  <<< 36, a@11 <<< 10, a@17 <<< 15, a@23 <<< 56
  , a@2  <<< 62, a@8  <<< 55, a@14 <<< 39, a@15 <<< 41, a@21 <<< 2 ]

// CHI, section 3.2.4, the one non-linear step. Written out lane by lane
// rather than with index arithmetic, so that the wrap at x = 3 and x = 4 --
// where the neighbour is back at the start of the row rather than above it --
// is visible rather than implied. This is the same twenty five blocks the
// skeleton has, in the same order.
keccakChi : [25][64] -> [25][64]
keccakChi b =
  [ (b@0 ) ^ ((~ (b@1 )) && (b@2 ))
  , (b@1 ) ^ ((~ (b@2 )) && (b@3 ))
  , (b@2 ) ^ ((~ (b@3 )) && (b@4 ))
  , (b@3 ) ^ ((~ (b@4 )) && (b@0 ))
  , (b@4 ) ^ ((~ (b@0 )) && (b@1 ))
  , (b@5 ) ^ ((~ (b@6 )) && (b@7 ))
  , (b@6 ) ^ ((~ (b@7 )) && (b@8 ))
  , (b@7 ) ^ ((~ (b@8 )) && (b@9 ))
  , (b@8 ) ^ ((~ (b@9 )) && (b@5 ))
  , (b@9 ) ^ ((~ (b@5 )) && (b@6 ))
  , (b@10) ^ ((~ (b@11)) && (b@12))
  , (b@11) ^ ((~ (b@12)) && (b@13))
  , (b@12) ^ ((~ (b@13)) && (b@14))
  , (b@13) ^ ((~ (b@14)) && (b@10))
  , (b@14) ^ ((~ (b@10)) && (b@11))
  , (b@15) ^ ((~ (b@16)) && (b@17))
  , (b@16) ^ ((~ (b@17)) && (b@18))
  , (b@17) ^ ((~ (b@18)) && (b@19))
  , (b@18) ^ ((~ (b@19)) && (b@15))
  , (b@19) ^ ((~ (b@15)) && (b@16))
  , (b@20) ^ ((~ (b@21)) && (b@22))
  , (b@21) ^ ((~ (b@22)) && (b@23))
  , (b@22) ^ ((~ (b@23)) && (b@24))
  , (b@23) ^ ((~ (b@24)) && (b@20))
  , (b@24) ^ ((~ (b@20)) && (b@21))
  ]

// in = A(200); out = A(200) with rho and pi applied.
keccakRhoPiRun : [200][8] -> [200][8]
keccakRhoPiRun inb = keccakBytes (keccakRhoPi (keccakLanes inb))

// in = A(200); out = A(200) with rho, pi and then chi applied. The array pi
// writes is the array chi reads, which is why one brainfuck routine does both.
keccakRhoPiChiRun : [200][8] -> [200][8]
keccakRhoPiChiRun inb = keccakBytes (keccakChi (keccakRhoPi (keccakLanes inb)))

// IOTA, section 3.2.5: lane nought takes the round's constant and nothing
// else changes. One exclusive or, which is why keccak/permute1600.skel has it
// inline rather than in a routine of its own.
keccakRound : ([25][64], [64]) -> [25][64]
keccakRound (a, rc) = update b 0 ((b@0) ^ rc)
  where b = keccakChi (keccakRhoPi (keccakTheta a))

// The twenty four round constants of Appendix A, written out rather than
// generated from the linear feedback register of section 3.2.5. A constant has
// bits only at positions one less than a power of two, which is why only bytes
// nought, one, three and seven of a lane are ever anything but nought -- and
// why keccak/permute1600.skel can write the whole table as plusses.
keccakRC : [24][64]
keccakRC =
  [ 0x0000000000000001, 0x0000000000008082, 0x800000000000808a
  , 0x8000000080008000, 0x000000000000808b, 0x0000000080000001
  , 0x8000000080008081, 0x8000000000008009, 0x000000000000008a
  , 0x0000000000000088, 0x0000000080008009, 0x000000008000000a
  , 0x000000008000808b, 0x800000000000008b, 0x8000000000008089
  , 0x8000000000008003, 0x8000000000008002, 0x8000000000000080
  , 0x000000000000800a, 0x800000008000000a, 0x8000000080008081
  , 0x8000000000008080, 0x0000000080000001, 0x8000000080008008
  ]

keccakPermute : [25][64] -> [25][64]
keccakPermute a0 = ss ! 0
  where ss = [a0] # [ keccakRound (s, rc) | s <- ss | rc <- keccakRC ]

// in = A(200); out = A(200) with all twenty four rounds applied.
keccakPermuteRun : [200][8] -> [200][8]
keccakPermuteRun inb = keccakBytes (keccakPermute (keccakLanes inb))

// ==== the sponge, FIPS 202 section 4 ====
//
// One rate of the state takes the block, the permutation stirs it, and the
// answer is read off the front. keccak/sha3_256.bf is this at rate 136 with
// the pad byte 0x06.
keccakXorBlock : [25][64] -> [136][8] -> [25][64]
keccakXorBlock s blk = [ l ^ x | l <- s | x <- keccakLanes (blk # zero) ]

keccakAbsorb : {b} (fin b, b >= 1) => [b][136][8] -> [25][64]
keccakAbsorb blocks = ss ! 0
  where ss = [zero] # [ keccakPermute (keccakXorBlock s blk)
                      | s <- ss | blk <- blocks ]

// The padding is m # 0x06 # zeros # 0x80 filled out to a whole number of
// rates, and the 0x80 lands on the last byte of the LAST block only. Where
// the message leaves exactly one byte of the rate free, the 0x06 and the 0x80
// are the same byte and it is 0x86 -- which is why there is a Full form.
keccakPad1 : {n} (fin n, n <= 134) => [n][8] -> [1][136][8]
keccakPad1 m = [m # [0x06] # (zero : [134 - n][8]) # [0x80]]

keccakPad1Full : [135][8] -> [1][136][8]
keccakPad1Full m = [m # [0x86]]

keccakPad2 : {n} (fin n, n >= 136, n <= 270) => [n][8] -> [2][136][8]
keccakPad2 m = split (m # [0x06] # (zero : [270 - n][8]) # [0x80])

sha3_256Out : [25][64] -> [32][8]
sha3_256Out s = take`{32} (keccakBytes s)

// SHA3-256 over the wire, as keccak/sha3_256.bf reads it: len(2 LE) then the
// message. One Run per length, because Cryptol's padding is indexed by it.

sha3_256Run_0 : [2][8] -> [32][8]
sha3_256Run_0 inb = sha3_256Out (keccakAbsorb (keccakPad1`{0} (drop`{2} inb)))

sha3_256Run_3 : [5][8] -> [32][8]
sha3_256Run_3 inb = sha3_256Out (keccakAbsorb (keccakPad1`{3} (drop`{2} inb)))

sha3_256Run_135 : [137][8] -> [32][8]
sha3_256Run_135 inb = sha3_256Out (keccakAbsorb (keccakPad1Full (drop`{2} inb)))

sha3_256Run_136 : [138][8] -> [32][8]
sha3_256Run_136 inb = sha3_256Out (keccakAbsorb (keccakPad2`{136} (drop`{2} inb)))

// ==== the squeeze, and the padding byte as a parameter ====
//
// ROTSTATE: keccak/rotstate.bf turns the state over by one cell, so the byte
// about to go out is always the bottom one and the squeeze needs no index. A
// sequence rotated left by one is exactly that, so this is the whole of it.
keccakRotStateRun : [200][8] -> [200][8]
keccakRotStateRun s = s <<< 1

// The padding rule with the byte itself given, which is what
// keccak/sponge136.bf reads from the wire. keccakPad1 above is this form with
// 0x06 written in, and both stay: the SHA3-256 vectors were pinned against
// that one and a vector's expression should not move under it.
keccakPadB1 : {n} (fin n, n <= 134) => [8] -> [n][8] -> [1][136][8]
keccakPadB1 p m = [m # [p] # (zero : [134 - n][8]) # [0x80]]

keccakPadB1Full : [8] -> [135][8] -> [1][136][8]
keccakPadB1Full p m = [m # [p || 0x80]]

keccakPadB2 : {n} (fin n, n >= 136, n <= 270) => [8] -> [n][8] -> [2][136][8]
keccakPadB2 p m = split (m # [p] # (zero : [270 - n][8]) # [0x80])

// The squeeze at rate 136: the first 136 bytes of the state, then the first
// 136 of the permuted state, and so on for as long as the caller wants. SHA3
// takes 32 bytes and stops inside the first rate, so keccak/sha3_256.bf never
// needed this; SHAKE may ask for more than a rate, and this is the loop
// keccak/sponge136.bf runs to serve it.
keccakSqueeze136 : {n} (fin n) => [25][64] -> [n][8]
keccakSqueeze136 s = take`{n} (join [ take`{136} (keccakBytes t) | t <- ts ])
  where ts : [inf][25][64]
        ts = [s] # [ keccakPermute u | u <- ts ]

// SPONGE136 over the wire, as keccak/sponge136.bf reads it: pad(1),
// mlen(2 LE), olen(2 LE), then the message. The padding byte comes off the
// wire, so one program answers for both functions at this rate.
sponge136Run_0_32 : [5][8] -> [32][8]
sponge136Run_0_32 inb =
    keccakSqueeze136`{32} (keccakAbsorb (keccakPadB1`{0} (inb@0) (drop`{5} inb)))

sponge136Run_0_137 : [5][8] -> [137][8]
sponge136Run_0_137 inb =
    keccakSqueeze136`{137} (keccakAbsorb (keccakPadB1`{0} (inb@0) (drop`{5} inb)))

// SHAKE256 over the wire, as keccak/shake256.bf reads it: mlen(2 LE),
// olen(2 LE), then the message. 0x1f is FIPS 202's padding byte for the SHAKE
// functions and it is written in here, because that file writes it in too.
shake256Run_0_32 : [4][8] -> [32][8]
shake256Run_0_32 inb =
    keccakSqueeze136`{32} (keccakAbsorb (keccakPadB1`{0} 0x1f (drop`{4} inb)))

shake256Run_3_32 : [7][8] -> [32][8]
shake256Run_3_32 inb =
    keccakSqueeze136`{32} (keccakAbsorb (keccakPadB1`{3} 0x1f (drop`{4} inb)))

shake256Run_0_136 : [4][8] -> [136][8]
shake256Run_0_136 inb =
    keccakSqueeze136`{136} (keccakAbsorb (keccakPadB1`{0} 0x1f (drop`{4} inb)))

shake256Run_0_137 : [4][8] -> [137][8]
shake256Run_0_137 inb =
    keccakSqueeze136`{137} (keccakAbsorb (keccakPadB1`{0} 0x1f (drop`{4} inb)))

shake256Run_136_32 : [140][8] -> [32][8]
shake256Run_136_32 inb =
    keccakSqueeze136`{32} (keccakAbsorb (keccakPadB2`{136} 0x1f (drop`{4} inb)))

// ==== the same sponge at rate 168, which is SHAKE128's ====
//
// A rate is not a parameter in the brainfuck and it is not one here either,
// because the point of this file is to be an INDEPENDENT oracle: a rate
// written twice is two chances to read FIPS 202 the same way, and one shared
// definition would let a single misreading answer for both. So these are the
// rate 136 definitions above with 168 in them, and nothing else.
keccakXorBlock168 : [25][64] -> [168][8] -> [25][64]
keccakXorBlock168 s blk = [ l ^ x | l <- s | x <- keccakLanes (blk # zero) ]

keccakAbsorb168 : {b} (fin b, b >= 1) => [b][168][8] -> [25][64]
keccakAbsorb168 blocks = ss ! 0
  where ss = [zero] # [ keccakPermute (keccakXorBlock168 s blk)
                      | s <- ss | blk <- blocks ]

keccakPad168B1 : {n} (fin n, n <= 166) => [8] -> [n][8] -> [1][168][8]
keccakPad168B1 p m = [m # [p] # (zero : [166 - n][8]) # [0x80]]

keccakPad168B1Full : [8] -> [167][8] -> [1][168][8]
keccakPad168B1Full p m = [m # [p || 0x80]]

keccakPad168B2 : {n} (fin n, n >= 168, n <= 334) => [8] -> [n][8] -> [2][168][8]
keccakPad168B2 p m = split (m # [p] # (zero : [334 - n][8]) # [0x80])

keccakSqueeze168 : {n} (fin n) => [25][64] -> [n][8]
keccakSqueeze168 s = take`{n} (join [ take`{168} (keccakBytes t) | t <- ts ])
  where ts : [inf][25][64]
        ts = [s] # [ keccakPermute u | u <- ts ]

// SPONGE168 over the wire, as keccak/sponge168.bf reads it: pad(1),
// mlen(2 LE), olen(2 LE), then the message.
sponge168Run_0_32 : [5][8] -> [32][8]
sponge168Run_0_32 inb =
    keccakSqueeze168`{32} (keccakAbsorb168 (keccakPad168B1`{0} (inb@0) (drop`{5} inb)))

sponge168Run_0_169 : [5][8] -> [169][8]
sponge168Run_0_169 inb =
    keccakSqueeze168`{169} (keccakAbsorb168 (keccakPad168B1`{0} (inb@0) (drop`{5} inb)))

// SHAKE128 over the wire, as keccak/shake128.bf reads it: mlen(2 LE),
// olen(2 LE), then the message. 0x1f is FIPS 202's padding byte for the SHAKE
// functions at every rate.
shake128Run_0_32 : [4][8] -> [32][8]
shake128Run_0_32 inb =
    keccakSqueeze168`{32} (keccakAbsorb168 (keccakPad168B1`{0} 0x1f (drop`{4} inb)))

shake128Run_3_32 : [7][8] -> [32][8]
shake128Run_3_32 inb =
    keccakSqueeze168`{32} (keccakAbsorb168 (keccakPad168B1`{3} 0x1f (drop`{4} inb)))

shake128Run_0_168 : [4][8] -> [168][8]
shake128Run_0_168 inb =
    keccakSqueeze168`{168} (keccakAbsorb168 (keccakPad168B1`{0} 0x1f (drop`{4} inb)))

shake128Run_0_169 : [4][8] -> [169][8]
shake128Run_0_169 inb =
    keccakSqueeze168`{169} (keccakAbsorb168 (keccakPad168B1`{0} 0x1f (drop`{4} inb)))

shake128Run_168_32 : [172][8] -> [32][8]
shake128Run_168_32 inb =
    keccakSqueeze168`{32} (keccakAbsorb168 (keccakPad168B2`{168} 0x1f (drop`{4} inb)))

// ==== SHA3-224, SHA3-384 and SHA3-512: one shape at three more rates ====
//
// These three are the same file three times over with a different rate and a
// different digest length, so here they are the same definition over the rate.
// The 136 and 168 forms above are written out long-hand on purpose -- each was
// a fresh reading of FIPS 202 while the brainfuck it checks was being written,
// and two readings that agree are worth more than one reused. By the time the
// third rate arrived there was nothing left to read afresh.
keccakAbsorbRate : {r, b} (fin r, fin b, b >= 1, r <= 200) => [b][r][8] -> [25][64]
keccakAbsorbRate blocks = ss ! 0
  where ss = [zero] # [ keccakPermute [ l ^ x
                                      | l <- s
                                      | x <- keccakLanes (blk # (zero : [200 - r][8])) ]
                      | s <- ss | blk <- blocks ]

keccakPadRate1 : {r, n} (fin r, fin n, r >= 2, n <= r - 2) => [n][8] -> [1][r][8]
keccakPadRate1 m = [m # [0x06] # (zero : [r - 2 - n][8]) # [0x80]]

keccakPadRate1Full : {r} (fin r, r >= 1) => [r - 1][8] -> [1][r][8]
keccakPadRate1Full m = [m # [0x86]]

keccakPadRate2 : {r, n} (fin r, fin n, r >= 1, n >= r, n <= 2 * r - 2) =>
                 [n][8] -> [2][r][8]
keccakPadRate2 m = split (m # [0x06] # (zero : [2 * r - 2 - n][8]) # [0x80])

sha3OutRate : {d} (fin d, d <= 200) => [25][64] -> [d][8]
sha3OutRate s = take`{d} (keccakBytes s)

// SHA3-224 over the wire, as keccak/sha3_224.bf reads it: len(2 LE) then the
// message. Rate 144, digest 28.
sha3_224Run_0 : [2][8] -> [28][8]
sha3_224Run_0 inb = sha3OutRate`{28} (keccakAbsorbRate (keccakPadRate1`{144,0} (drop`{2} inb)))

sha3_224Run_3 : [5][8] -> [28][8]
sha3_224Run_3 inb = sha3OutRate`{28} (keccakAbsorbRate (keccakPadRate1`{144,3} (drop`{2} inb)))

sha3_224Run_143 : [145][8] -> [28][8]
sha3_224Run_143 inb = sha3OutRate`{28} (keccakAbsorbRate (keccakPadRate1Full`{144} (drop`{2} inb)))

sha3_224Run_144 : [146][8] -> [28][8]
sha3_224Run_144 inb = sha3OutRate`{28} (keccakAbsorbRate (keccakPadRate2`{144,144} (drop`{2} inb)))

// SHA3-384: rate 104, digest 48.
sha3_384Run_0 : [2][8] -> [48][8]
sha3_384Run_0 inb = sha3OutRate`{48} (keccakAbsorbRate (keccakPadRate1`{104,0} (drop`{2} inb)))

sha3_384Run_3 : [5][8] -> [48][8]
sha3_384Run_3 inb = sha3OutRate`{48} (keccakAbsorbRate (keccakPadRate1`{104,3} (drop`{2} inb)))

sha3_384Run_103 : [105][8] -> [48][8]
sha3_384Run_103 inb = sha3OutRate`{48} (keccakAbsorbRate (keccakPadRate1Full`{104} (drop`{2} inb)))

sha3_384Run_104 : [106][8] -> [48][8]
sha3_384Run_104 inb = sha3OutRate`{48} (keccakAbsorbRate (keccakPadRate2`{104,104} (drop`{2} inb)))

// SHA3-512: rate 72, digest 64.
sha3_512Run_0 : [2][8] -> [64][8]
sha3_512Run_0 inb = sha3OutRate`{64} (keccakAbsorbRate (keccakPadRate1`{72,0} (drop`{2} inb)))

sha3_512Run_3 : [5][8] -> [64][8]
sha3_512Run_3 inb = sha3OutRate`{64} (keccakAbsorbRate (keccakPadRate1`{72,3} (drop`{2} inb)))

sha3_512Run_71 : [73][8] -> [64][8]
sha3_512Run_71 inb = sha3OutRate`{64} (keccakAbsorbRate (keccakPadRate1Full`{72} (drop`{2} inb)))

sha3_512Run_72 : [74][8] -> [64][8]
sha3_512Run_72 inb = sha3OutRate`{64} (keccakAbsorbRate (keccakPadRate2`{72,72} (drop`{2} inb)))

// XOR64: the 64-bit widening of chacha20/xor32.
// in = x(8 LE) # y(8 LE); out = (x xor y)(8 LE). Stated on its own rather
// than parameterised over the width, for the same reason leWord64 sits
// beside leWord: every call site reads better named.
xor64Run : [16][8] -> [8][8]
xor64Run inb = leBytes64 (leWord64 (take`{8} inb) ^ leWord64 (drop`{8} inb))

// AND64: the 64-bit widening of idiom/and32.
// in = x(8 LE) # y(8 LE); out = (x and y)(8 LE). Between this and xor64,
// SHA-512's Ch and Maj need no NOT at all.
and64Run : [16][8] -> [8][8]
and64Run inb = leBytes64 (leWord64 (take`{8} inb) && leWord64 (drop`{8} inb))

// ADD64: the 64-bit widening of chacha20/add32.
// in = a(8 LE) # b(8 LE); out = (a plus b mod 2^64)(8 LE). Cryptol's + on
// [64] drops the carry out of bit 63 by construction, so this spec says
// nothing at all about the wrap and the brainfuck is what has to get it
// right -- which is why the pinned vectors carry the cascade case.
add64Run : [16][8] -> [8][8]
add64Run inb = leBytes64 (leWord64 (take`{8} inb) + leWord64 (drop`{8} inb))

// ---------------------------------------------------------------------------
// SHA-256 (FIPS 180-4). Written out from the standard rather than taken from
// Cryptol's own library, so that oracle B is independent of whatever the
// toolchain happens to ship.

sha256K : [64][32]
sha256K =
  [
     0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
     0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
     0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
     0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
     0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
     0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
     0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
     0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
     0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
     0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
     0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
     0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
     0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
     0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
     0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
     0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
  ]

sha256H0 : [8][32]
sha256H0 =
  [
     0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
     0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
  ]

// One round of the compression function, exactly as sha256/round.bf does it.
sha256Step : [8][32] -> [32] -> [32] -> [8][32]
sha256Step v kt wt = [t1 + t2, a, b, c, d + t1, e, f, g]
  where
    a  = v @ (0 : [8])
    b  = v @ (1 : [8])
    c  = v @ (2 : [8])
    d  = v @ (3 : [8])
    e  = v @ (4 : [8])
    f  = v @ (5 : [8])
    g  = v @ (6 : [8])
    h  = v @ (7 : [8])
    s1 = (e >>> 6) ^ (e >>> 11) ^ (e >>> 25)
    ch = g ^ (e && (f ^ g))
    t1 = h + s1 + ch + kt + wt
    s0 = (a >>> 2) ^ (a >>> 13) ^ (a >>> 22)
    mj = (a && b) ^ (a && c) ^ (b && c)
    t2 = s0 + mj

sha256Sig0 : [32] -> [32]
sha256Sig0 x = (x >>> 7) ^ (x >>> 18) ^ (x >> 3)

sha256Sig1 : [32] -> [32]
sha256Sig1 x = (x >>> 17) ^ (x >>> 19) ^ (x >> 10)

// One step of the schedule, written as the sliding window the brainfuck keeps
// rather than as a recurrence over an array: sixteen words, four fixed taps,
// one new word appended. sha256/expand.bf is handed exactly those four taps.
sha256SchedStep : [16][32] -> [16][32]
sha256SchedStep w = drop`{1} w # [nw]
  where
    nw = sha256Sig1 (w @ (14 : [8])) + (w @ (9 : [8]))
       + sha256Sig0 (w @ (1  : [8])) + (w @ (0 : [8]))

sha256Sched : [16][32] -> [64][32]
sha256Sched m = m # [ w @ (15 : [8]) | w <- take`{48} (drop`{1} wins) ]
  where
    wins = [m] # [ sha256SchedStep w | w <- wins ]

// A block is sixteen BIG endian words; that is the one place SHA-256 disagrees
// with the rest of this library, and the brainfuck reverses each word as it
// loads it.
sha256Words : [64][8] -> [16][32]
sha256Words blk = [ join grp | grp <- split`{16} blk ]

sha256Compress : [8][32] -> [64][8] -> [8][32]
sha256Compress hin blk = [ x + y | x <- hin | y <- vs @ (64 : [8]) ]
  where
    ws = sha256Sched (sha256Words blk)
    vs = [hin] # [ sha256Step v kt wt | v <- vs | kt <- sha256K | wt <- ws ]

// The digest is printed big endian, as the standard prints it.
sha256Out : [8][32] -> [32][8]
sha256Out h = join [ split w | w <- h ]

// Padding: a ONE bit, then zeros, then the length in BITS as a big endian
// sixty four bit number, filling out whole blocks.
sha256Pad1 : {n} (fin n, n <= 55) => [n][8] -> [64][8]
sha256Pad1 m = m # [0x80] # (zero : [55 - n][8]) # split (`(8 * n) : [64])

sha256Pad2 : {n} (fin n, n >= 56, n <= 119) => [n][8] -> [128][8]
sha256Pad2 m = m # [0x80] # (zero : [119 - n][8]) # split (`(8 * n) : [64])

// ROUND: in = v(8 words LE) # Wt(4 LE) # Kt(4 LE); out = v(8 words LE).
sha256RoundRun : [40][8] -> [32][8]
sha256RoundRun inb = join [ leBytes x | x <- sha256Step v kt wt ]
  where
    v  = [ leWord grp | grp <- split`{8} (take`{32} inb) ]
    wt = leWord (take`{4} (drop`{32} inb))
    kt = leWord (drop`{36} inb)

// EXPAND: in = w0 # w1 # w9 # w14, each four LE bytes; out = the next word.
sha256ExpandRun : [16][8] -> [4][8]
sha256ExpandRun inb = leBytes (w0 + sg0 w1 + w9 + sg1 w14)
  where
    w0  = leWord (take`{4} inb)
    w1  = leWord (take`{4} (drop`{4} inb))
    w9  = leWord (take`{4} (drop`{8} inb))
    w14 = leWord (drop`{12} inb)
    sg0 x = (x >>> 7) ^ (x >>> 18) ^ (x >> 3)
    sg1 x = (x >>> 17) ^ (x >>> 19) ^ (x >> 10)

// ---------------------------------------------------------------------------
// SHA-512 (FIPS 180-4). Written out from the standard for the same reason
// SHA-256 was: oracle B has to be independent of whatever Cryptol ships.
//
// EXPAND: in = w0 # w1 # w9 # w14, each eight LE bytes; out = the next word.
// The recurrence is SHA-256's; only the six rotation and shift counts differ.
sha512ExpandRun : [32][8] -> [8][8]
sha512ExpandRun inb = leBytes64 (w0 + sg0 w1 + w9 + sg1 w14)
  where
    w0  = leWord64 (take`{8} inb)
    w1  = leWord64 (take`{8} (drop`{8} inb))
    w9  = leWord64 (take`{8} (drop`{16} inb))
    w14 = leWord64 (drop`{24} inb)
    sg0 x = (x >>> 1) ^ (x >>> 8) ^ (x >> 7)
    sg1 x = (x >>> 19) ^ (x >>> 61) ^ (x >> 6)

// One round of the SHA-512 compression function. The same shape as
// sha256Step; only the six big sigma counts and the word width differ.
sha512Step : [8][64] -> [64] -> [64] -> [8][64]
sha512Step v kt wt = [t1 + t2, a, b, c, d + t1, e, f, g]
  where
    a  = v @ (0 : [8])
    b  = v @ (1 : [8])
    c  = v @ (2 : [8])
    d  = v @ (3 : [8])
    e  = v @ (4 : [8])
    f  = v @ (5 : [8])
    g  = v @ (6 : [8])
    h  = v @ (7 : [8])
    s1 = (e >>> 14) ^ (e >>> 18) ^ (e >>> 41)
    ch = g ^ (e && (f ^ g))
    t1 = h + s1 + ch + kt + wt
    s0 = (a >>> 28) ^ (a >>> 34) ^ (a >>> 39)
    mj = (a && b) ^ (a && c) ^ (b && c)
    t2 = s0 + mj

// ROUND: in = v(8 words LE) # Wt(8 LE) # Kt(8 LE); out = v(8 words LE).
sha512RoundRun : [80][8] -> [64][8]
sha512RoundRun inb = join [ leBytes64 x | x <- sha512Step v kt wt ]
  where
    v  = [ leWord64 grp | grp <- split`{8} (take`{64} inb) ]
    wt = leWord64 (take`{8} (drop`{64} inb))
    kt = leWord64 (drop`{72} inb)


// Written out per length, as the Poly1305 and AEAD oracles are: the number of
// blocks and the width of the padding are type level facts here.

sha256Run_0 : [2][8] -> [32][8]
sha256Run_0 inb =
    sha256Out (sha256Compress sha256H0 (sha256Pad1`{0} (drop`{2} inb)))

sha256Run_1 : [3][8] -> [32][8]
sha256Run_1 inb =
    sha256Out (sha256Compress sha256H0 (sha256Pad1`{1} (drop`{2} inb)))

sha256Run_3 : [5][8] -> [32][8]
sha256Run_3 inb =
    sha256Out (sha256Compress sha256H0 (sha256Pad1`{3} (drop`{2} inb)))

sha256Run_55 : [57][8] -> [32][8]
sha256Run_55 inb =
    sha256Out (sha256Compress sha256H0 (sha256Pad1`{55} (drop`{2} inb)))

sha256Run_56 : [58][8] -> [32][8]
sha256Run_56 inb = sha256Out h2
  where
    p  = sha256Pad2`{56} (drop`{2} inb)
    h1 = sha256Compress sha256H0 (take`{64} p)
    h2 = sha256Compress h1 (drop`{64} p)

sha256Run_64 : [66][8] -> [32][8]
sha256Run_64 inb = sha256Out h2
  where
    p  = sha256Pad2`{64} (drop`{2} inb)
    h1 = sha256Compress sha256H0 (take`{64} p)
    h2 = sha256Compress h1 (drop`{64} p)

// HASHCORE: the hash over a prefix in memory and then bytes from the wire.
// Written per length, as the other oracles are; plen and slen arrive ahead of a
// fixed 256 byte prefix buffer of which only the first plen bytes matter.
//   in  = plen(2 LE) # slen(2 LE) # pbuf(256) # slen bytes
//   out = digest(32) big endian

hashcoreRun_0_3 : [263][8] -> [32][8]
hashcoreRun_0_3 inb = sha256Out (hs @ (1 : [8]))
  where
    msg = drop`{260} inb
    hs  = [sha256H0] # [ sha256Compress h b
                       | h <- hs | b <- split`{1} (sha256Pad1`{3} msg) ]

hashcoreRun_3_0 : [260][8] -> [32][8]
hashcoreRun_3_0 inb = sha256Out (hs @ (1 : [8]))
  where
    msg = take`{3} (drop`{4} inb)
    hs  = [sha256H0] # [ sha256Compress h b
                       | h <- hs | b <- split`{1} (sha256Pad1`{3} msg) ]

hashcoreRun_1_2 : [262][8] -> [32][8]
hashcoreRun_1_2 inb = sha256Out (hs @ (1 : [8]))
  where
    msg = take`{1} (drop`{4} inb) # drop`{260} inb
    hs  = [sha256H0] # [ sha256Compress h b
                       | h <- hs | b <- split`{1} (sha256Pad1`{3} msg) ]

hashcoreRun_0_0 : [260][8] -> [32][8]
hashcoreRun_0_0 inb = sha256Out (hs @ (1 : [8]))
  where
    msg = ([] : [0][8])
    hs  = [sha256H0] # [ sha256Compress h b
                       | h <- hs | b <- split`{1} (sha256Pad1`{0} msg) ]

hashcoreRun_64_0 : [260][8] -> [32][8]
hashcoreRun_64_0 inb = sha256Out (hs @ (2 : [8]))
  where
    msg = take`{64} (drop`{4} inb)
    hs  = [sha256H0] # [ sha256Compress h b
                       | h <- hs | b <- split`{2} (sha256Pad2`{64} msg) ]

hashcoreRun_30_34 : [294][8] -> [32][8]
hashcoreRun_30_34 inb = sha256Out (hs @ (2 : [8]))
  where
    msg = take`{30} (drop`{4} inb) # drop`{260} inb
    hs  = [sha256H0] # [ sha256Compress h b
                       | h <- hs | b <- split`{2} (sha256Pad2`{64} msg) ]

// HMAC-SHA-256, RFC 2104: H( (K xor opad) then H( (K xor ipad) then message ) )
// with K the key padded to a block. Only the two pads are new; both hashes are
// ordinary SHA-256 over a byte string.
hmacIpad : [64][8] -> [64][8]
hmacIpad kpad = [ k ^ 0x36 | k <- kpad ]

hmacOpad : [64][8] -> [64][8]
hmacOpad kpad = [ k ^ 0x5c | k <- kpad ]

hmacRun_20_0_8 : [526][8] -> [32][8]
hmacRun_20_0_8 inb = sha256Out (hOut @ (2 : [8]))
  where
    kpad = take`{20} (drop`{6} inb) # (zero : [44][8])
    msg  = drop`{518} inb
    inn  = sha256Out (hIn @ (2 : [8]))
    hIn  = [sha256H0] # [ sha256Compress h b | h <- hIn
                        | b <- split`{2} (sha256Pad2`{72} (hmacIpad kpad # msg)) ]
    hOut = [sha256H0] # [ sha256Compress h b | h <- hOut
                        | b <- split`{2} (sha256Pad2`{96} (hmacOpad kpad # inn)) ]

hmacRun_20_8_0 : [518][8] -> [32][8]
hmacRun_20_8_0 inb = sha256Out (hOut @ (2 : [8]))
  where
    kpad = take`{20} (drop`{6} inb) # (zero : [44][8])
    msg  = take`{8} (drop`{262} inb)
    inn  = sha256Out (hIn @ (2 : [8]))
    hIn  = [sha256H0] # [ sha256Compress h b | h <- hIn
                        | b <- split`{2} (sha256Pad2`{72} (hmacIpad kpad # msg)) ]
    hOut = [sha256H0] # [ sha256Compress h b | h <- hOut
                        | b <- split`{2} (sha256Pad2`{96} (hmacOpad kpad # inn)) ]

hmacRun_4_0_28 : [546][8] -> [32][8]
hmacRun_4_0_28 inb = sha256Out (hOut @ (2 : [8]))
  where
    kpad = take`{4} (drop`{6} inb) # (zero : [60][8])
    msg  = drop`{518} inb
    inn  = sha256Out (hIn @ (2 : [8]))
    hIn  = [sha256H0] # [ sha256Compress h b | h <- hIn
                        | b <- split`{2} (sha256Pad2`{92} (hmacIpad kpad # msg)) ]
    hOut = [sha256H0] # [ sha256Compress h b | h <- hOut
                        | b <- split`{2} (sha256Pad2`{96} (hmacOpad kpad # inn)) ]

hmacRun_20_0_50 : [568][8] -> [32][8]
hmacRun_20_0_50 inb = sha256Out (hOut @ (2 : [8]))
  where
    kpad = take`{20} (drop`{6} inb) # (zero : [44][8])
    msg  = drop`{518} inb
    inn  = sha256Out (hIn @ (2 : [8]))
    hIn  = [sha256H0] # [ sha256Compress h b | h <- hIn
                        | b <- split`{2} (sha256Pad2`{114} (hmacIpad kpad # msg)) ]
    hOut = [sha256H0] # [ sha256Compress h b | h <- hOut
                        | b <- split`{2} (sha256Pad2`{96} (hmacOpad kpad # inn)) ]

hmacRun_0_0_0 : [518][8] -> [32][8]
hmacRun_0_0_0 inb = sha256Out (hOut @ (2 : [8]))
  where
    kpad = (zero : [64][8])
    msg  = ([] : [0][8])
    inn  = sha256Out (hIn @ (2 : [8]))
    hIn  = [sha256H0] # [ sha256Compress h b | h <- hIn
                        | b <- split`{2} (sha256Pad2`{64} (hmacIpad kpad # msg)) ]
    hOut = [sha256H0] # [ sha256Compress h b | h <- hOut
                        | b <- split`{2} (sha256Pad2`{96} (hmacOpad kpad # inn)) ]

hmacRun_32_3_3 : [521][8] -> [32][8]
hmacRun_32_3_3 inb = sha256Out (hOut @ (2 : [8]))
  where
    kpad = take`{32} (drop`{6} inb) # (zero : [32][8])
    msg  = take`{3} (drop`{262} inb) # drop`{518} inb
    inn  = sha256Out (hIn @ (2 : [8]))
    hIn  = [sha256H0] # [ sha256Compress h b | h <- hIn
                        | b <- split`{2} (sha256Pad2`{70} (hmacIpad kpad # msg)) ]
    hOut = [sha256H0] # [ sha256Compress h b | h <- hOut
                        | b <- split`{2} (sha256Pad2`{96} (hmacOpad kpad # inn)) ]

// ---------------------------------------------------------------------------
// HKDF-SHA-256 (RFC 5869): extract a pseudorandom key, then expand it.

sha256Pad3 : {n} (fin n, n >= 120, n <= 183) => [n][8] -> [192][8]
sha256Pad3 m = m # [0x80] # (zero : [183 - n][8]) # split (`(8 * n) : [64])

// HMAC where both hashes come to two blocks, which is every call the A.1 and
// A.3 vectors make. Polymorphic in the key and message lengths, so one
// definition serves extract and every turn of expand.
hmac2 : {kn, mn} (fin kn, fin mn, kn <= 64, mn <= 55) => [kn][8] -> [mn][8] -> [32][8]
hmac2 key msg = sha256Out (hOut @ (2 : [8]))
  where
    kpad = key # (zero : [64 - kn][8])
    inn  = sha256Out (hIn @ (2 : [8]))
    hIn  = [sha256H0] # [ sha256Compress h b | h <- hIn
                        | b <- split`{2} (sha256Pad2`{64 + mn} (hmacIpad kpad # msg)) ]
    hOut = [sha256H0] # [ sha256Compress h b | h <- hOut
                        | b <- split`{2} (sha256Pad2`{96} (hmacOpad kpad # inn)) ]

// And the same where the inner message runs to three blocks, which A.2 needs
// because its info is eighty bytes long.
hmac3 : {kn, mn} (fin kn, fin mn, kn <= 64, mn >= 56, mn <= 119) =>
        [kn][8] -> [mn][8] -> [32][8]
hmac3 key msg = sha256Out (hOut @ (2 : [8]))
  where
    kpad = key # (zero : [64 - kn][8])
    inn  = sha256Out (hIn @ (3 : [8]))
    hIn  = [sha256H0] # [ sha256Compress h b | h <- hIn
                        | b <- split`{3} (sha256Pad3`{64 + mn} (hmacIpad kpad # msg)) ]
    hOut = [sha256H0] # [ sha256Compress h b | h <- hOut
                        | b <- split`{2} (sha256Pad2`{96} (hmacOpad kpad # inn)) ]

// RFC 5869 A.1: a thirteen byte salt, twenty two of keying material, ten of
// info, forty two bytes out. Two turns of expand, the second one truncated.
hkdfRun_13_22_10_42 : [776][8] -> [42][8]
hkdfRun_13_22_10_42 inb = take`{42} (t1 # t2)
  where
    salt = take`{13} (drop`{8} inb)
    ikm  = take`{22} (drop`{264} inb)
    info = take`{10} (drop`{520} inb)
    prk  = hmac2 salt ikm
    t1   = hmac2 prk (info # [1])
    t2   = hmac2 prk (t1 # info # [2])

// A.3: no salt and no info. RFC 5869 says an absent salt is HashLen noughts,
// which for SHA-256 is thirty two of them; that is not the same as a key of
// length nought and the distinction is the whole of this vector.
hkdfRun_0_22_0_42 : [776][8] -> [42][8]
hkdfRun_0_22_0_42 inb = take`{42} (t1 # t2)
  where
    ikm = take`{22} (drop`{264} inb)
    prk = hmac2 (zero : [32][8]) ikm
    t1  = hmac2 prk ([1] : [1][8])
    t2  = hmac2 prk (t1 # [2])

// A.2: eighty bytes of everything and eighty two out, so the salt is LONGER
// than a block and HMAC hashes it first; three turns of expand.
hkdfRun_80_80_80_82 : [776][8] -> [82][8]
hkdfRun_80_80_80_82 inb = take`{82} (t1 # t2 # t3)
  where
    salt = take`{80} (drop`{8} inb)
    ikm  = take`{80} (drop`{264} inb)
    info = take`{80} (drop`{520} inb)
    skey = sha256Out (hS @ (2 : [8]))
    hS   = [sha256H0] # [ sha256Compress h b | h <- hS
                        | b <- split`{2} (sha256Pad2`{80} salt) ]
    prk  = hmac3 skey ikm
    t1   = hmac3 prk (info # [1])
    t2   = hmac3 prk (t1 # info # [2])
    t3   = hmac3 prk (t2 # info # [3])

// ---------------------------------------------------------------------------
// NIST SP 800-108r1 section 4.1: the key derivation function in COUNTER MODE,
// with HMAC-SHA-256 as the PRF.
//
//   K(i) = PRF(Kin, [i]_r || FixedInput)   for i = 1 .. ceil(L / h)
//
// The counter is thirty two bits, big endian, and sits BEFORE the fixed input
// data, which is the arrangement CAVP tests and the one every caller in the
// wild uses. The standard leaves FixedInput to the caller -- conventionally
// Label || 0x00 || Context || [L]_2 -- so the routine takes it as one blob
// rather than asserting a layout the standard does not fix.
//
// Each vector is written out at the counter values it actually reaches, so
// that a wrong counter width or a counter that starts at nought is a wrong
// answer rather than a coincidence.
//
// IO: klen{2} LE  fixedlen{2} LE  okmlen{2} LE  kbuf{256}  fixedbuf{256}

// A fifth block of padding, which feedback mode needs at its longest fixed
// input: thirty two bytes of the previous block, four of counter and a
// hundred and fifty six of fixed input is a message of a hundred and ninety
// two, and under a block of key pad that is two hundred and fifty six.
sha256Pad5 : {n} (fin n, n >= 248, n <= 311) => [n][8] -> [320][8]
sha256Pad5 m = m # [0x80] # (zero : [311 - n][8]) # split (`(8 * n) : [64])

// HMAC-SHA-256 where the inner hash comes to five blocks. The outer is two
// whatever the message was, because its message is the key pad and a digest.
hmac5 : {kn, mn} (fin kn, fin mn, kn <= 64, mn >= 184, mn <= 247) =>
        [kn][8] -> [mn][8] -> [32][8]
hmac5 key msg = sha256Out (hOut @ (2 : [8]))
  where
    kpad = key # (zero : [64 - kn][8])
    inn  = sha256Out (hIn @ (5 : [8]))
    hIn  = [sha256H0] # [ sha256Compress h b | h <- hIn
                        | b <- split`{5} (sha256Pad5`{64 + mn} (hmacIpad kpad # msg)) ]
    hOut = [sha256H0] # [ sha256Compress h b | h <- hOut
                        | b <- split`{2} (sha256Pad2`{96} (hmacOpad kpad # inn)) ]

// One turn exactly, with sixty bytes of fixed input, so the PRF message is
// sixty four and the inner hash comes to three blocks.
kdfCtrRun_32_60_32 : [518][8] -> [32][8]
kdfCtrRun_32_60_32 inb = hmac3 key ([0, 0, 0, 1] # fixed)
  where
    key   = take`{32} (drop`{6} inb)
    fixed = take`{60} (drop`{262} inb)

// The same turn cut short. Half of K(1) is thrown away, which is the path
// that is wrong if the routine emits a whole block and then stops counting.
kdfCtrRun_32_60_16 : [518][8] -> [16][8]
kdfCtrRun_32_60_16 inb = take`{16} (hmac3 key ([0, 0, 0, 1] # fixed))
  where
    key   = take`{32} (drop`{6} inb)
    fixed = take`{60} (drop`{262} inb)

// Two whole turns, so the counter is seen to step and the fixed input is seen
// to survive the first turn unchanged.
kdfCtrRun_32_60_64 : [518][8] -> [64][8]
kdfCtrRun_32_60_64 inb = k1 # k2
  where
    key   = take`{32} (drop`{6} inb)
    fixed = take`{60} (drop`{262} inb)
    k1    = hmac3 key ([0, 0, 0, 1] # fixed)
    k2    = hmac3 key ([0, 0, 0, 2] # fixed)

// Fifty one bytes of fixed input puts the PRF message at fifty five, the last
// length whose inner hash is two blocks; the other side of that boundary.
kdfCtrRun_32_51_32 : [518][8] -> [32][8]
kdfCtrRun_32_51_32 inb = hmac2 key ([0, 0, 0, 1] # fixed)
  where
    key   = take`{32} (drop`{6} inb)
    fixed = take`{51} (drop`{262} inb)

// No fixed input at all, so the message is the counter and nothing else, and
// forty bytes out, so the second turn is truncated to eight.
kdfCtrRun_16_0_40 : [518][8] -> [40][8]
kdfCtrRun_16_0_40 inb = take`{40} (k1 # k2)
  where
    key = take`{16} (drop`{6} inb)
    k1  = hmac2 key ([0, 0, 0, 1] : [4][8])
    k2  = hmac2 key ([0, 0, 0, 2] : [4][8])

// ---------------------------------------------------------------------------
// NIST SP 800-108r1 section 4.2: the same key derivation function in FEEDBACK
// MODE, with HMAC-SHA-256 as the PRF.
//
//   K(0) = IV
//   K(i) = PRF(Kin, K(i-1) || [i]_r || FixedInput)
//
// The arrangement is the standard's own: the previous block, then the
// counter, then the fixed input. All three have fixed lengths, so all three
// land at cells the tape map names and nothing is placed by sliding, which is
// what makes this the same cheap shape as counter mode.
//
// THE IV IS ALWAYS PRESENT AND ALWAYS THIRTY TWO BYTES. An empty IV is an
// option in the standard and it would make the FIRST turn structurally
// different from every later one -- fixed input at offset four rather than
// thirty six -- which is the special case this arrangement exists to avoid.
//
// IO: klen{2} LE  fixedlen{2} LE  okmlen{2} LE  kbuf{256}  fixedbuf{256}
//     iv{32}

// One turn exactly. Twenty bytes of fixed input puts the PRF message at
// fifty six, the first length whose inner hash is three blocks.
kdfFbRun_32_20_32 : [550][8] -> [32][8]
kdfFbRun_32_20_32 inb = hmac3 key (iv # [0, 0, 0, 1] # fixed)
  where
    key   = take`{32} (drop`{6} inb)
    fixed = take`{20} (drop`{262} inb)
    iv    = take`{32} (drop`{518} inb)

// Two whole turns, which is the whole of what feedback mode adds: K(1) is the
// head of the second message, so a routine that reused the IV or kept the
// blocks in the wrong order is wrong here and right in the vector above.
kdfFbRun_32_20_64 : [550][8] -> [64][8]
kdfFbRun_32_20_64 inb = k1 # k2
  where
    key   = take`{32} (drop`{6} inb)
    fixed = take`{20} (drop`{262} inb)
    iv    = take`{32} (drop`{518} inb)
    k1    = hmac3 key (iv # [0, 0, 0, 1] # fixed)
    k2    = hmac3 key (k1 # [0, 0, 0, 2] # fixed)

// The second turn cut short, so the chain is made and then half thrown away.
kdfFbRun_32_20_48 : [550][8] -> [48][8]
kdfFbRun_32_20_48 inb = take`{48} (k1 # k2)
  where
    key   = take`{32} (drop`{6} inb)
    fixed = take`{20} (drop`{262} inb)
    iv    = take`{32} (drop`{518} inb)
    k1    = hmac3 key (iv # [0, 0, 0, 1] # fixed)
    k2    = hmac3 key (k1 # [0, 0, 0, 2] # fixed)

// No fixed input at all, so the message is the previous block and the counter
// and nothing else, and the inner hash drops to two blocks.
kdfFbRun_32_0_64 : [550][8] -> [64][8]
kdfFbRun_32_0_64 inb = k1 # k2
  where
    key = take`{32} (drop`{6} inb)
    iv  = take`{32} (drop`{518} inb)
    k1  = hmac2 key (iv # [0, 0, 0, 1])
    k2  = hmac2 key (k1 # [0, 0, 0, 2])

// A hundred and fifty six bytes of fixed input, which is the most this
// routine allows: the PRF message is a hundred and ninety two, which is the
// most sha256/hmac takes from memory, and the inner hash runs to five blocks.
// This vector exists to hold the copy run to the buffer it was sized for.
kdfFbRun_32_156_32 : [550][8] -> [32][8]
kdfFbRun_32_156_32 inb = hmac5 key (iv # [0, 0, 0, 1] # fixed)
  where
    key   = take`{32} (drop`{6} inb)
    fixed = take`{156} (drop`{262} inb)
    iv    = take`{32} (drop`{518} inb)

// ---------------------------------------------------------------------------
// PBKDF2 over HMAC-SHA-256: RFC 8018 section 5.2, and SP 800-132.
//
//   T(i) = U(1) xor U(2) xor ... xor U(c)
//   U(1) = PRF(P, S || INT_32_BE(i))
//   U(j) = PRF(P, U(j-1))
//
// The first two vectors are RFC 7914 section 11's published PBKDF2-HMAC-SHA256
// values, not values this file computed, so the brainfuck is checked against a
// third party AND a specification AND a standard's own printed answer.
//
// c is capped at two here and that is a limit on what can be RUN rather than
// on what the routine does: one iteration is about six and a half thousand
// million instructions, so the standard's own c = 4096 is twenty one million
// million, which is days. The loop is the same code at every count.
//
// IO: klen{2} LE  saltlen{2} LE  dklen{2} LE  c{4} LE  pwbuf{256}  saltbuf{256}

// One iteration and one block, which is the exclusive or with nothing to
// exclusive or against. RFC 7914 section 11's first PBKDF2-SHA256 vector.
pbkdf2Run_8_4_1_32 : [522][8] -> [32][8]
pbkdf2Run_8_4_1_32 inb = hmac2 pw (salt # [0, 0, 0, 1])
  where
    pw   = take`{8} (drop`{10} inb)
    salt = take`{4} (drop`{266} inb)

// Two iterations, where the exclusive or starts to matter and where a routine
// that returned U(c) instead of the running xor is wrong for the first time.
pbkdf2Run_8_4_2_32 : [522][8] -> [32][8]
pbkdf2Run_8_4_2_32 inb = u1 ^ u2
  where
    pw   = take`{8} (drop`{10} inb)
    salt = take`{4} (drop`{266} inb)
    u1   = hmac2 pw (salt # [0, 0, 0, 1])
    u2   = hmac2 pw u1

// Two output blocks at one iteration, so the block counter is seen to step
// and the salt is seen to survive the first block.
pbkdf2Run_8_4_1_64 : [522][8] -> [64][8]
pbkdf2Run_8_4_1_64 inb = t1 # t2
  where
    pw   = take`{8} (drop`{10} inb)
    salt = take`{4} (drop`{266} inb)
    t1   = hmac2 pw (salt # [0, 0, 0, 1])
    t2   = hmac2 pw (salt # [0, 0, 0, 2])

// Two iterations and a block cut short.
pbkdf2Run_8_4_2_20 : [522][8] -> [20][8]
pbkdf2Run_8_4_2_20 inb = take`{20} (u1 ^ u2)
  where
    pw   = take`{8} (drop`{10} inb)
    salt = take`{4} (drop`{266} inb)
    u1   = hmac2 pw (salt # [0, 0, 0, 1])
    u2   = hmac2 pw u1

// The longest salt the routine allows, a hundred and eighty eight, which puts
// the PRF message at a hundred and ninety two and leaves the slide nothing to
// do: the counter is dropped at two hundred and fifty two and belongs at a
// hundred and eighty eight, so it slides sixty four places and no further.
pbkdf2Run_8_188_1_32 : [522][8] -> [32][8]
pbkdf2Run_8_188_1_32 inb = hmac5 pw (salt # [0, 0, 0, 1])
  where
    pw   = take`{8} (drop`{10} inb)
    salt = take`{188} (drop`{266} inb)

// ---------------------------------------------------------------------------
// HMAC_DRBG over SHA-256: NIST SP 800-90A section 10.1.2, in the profile with
// no reseed, no prediction resistance and no additional input.
//
//   K starts at noughts and V at ones
//   Update(data): K = PRF(K, V||00||data); V = PRF(K,V)
//                 and again with 01 when data is not empty
//   Instantiate  = Update(entropy || nonce || personalisation)
//   Generate     = a run of V = PRF(K,V) blocks, then Update(empty)
//
// The first vector is NIST's OWN PUBLISHED CAVP value for HMAC_DRBG SHA-256,
// which instantiates, generates 1024 bits and throws them away, then
// generates again and compares. The discarded generate still has to happen,
// because it advances the state.
//
// IO: seedlen{2} LE  ngen{2} LE  dklen{2} LE  seedbuf{256}

// NIST's published vector. Sixteen hash calls, which is the most expensive
// single assertion in this suite and is here because it is the only value in
// this file that a standards body printed rather than this project computed.
drbgRun_48_2_128 : [262][8] -> [128][8]
drbgRun_48_2_128 inb = v8 # v9 # v10 # v11
  where
    seed = take`{48} (drop`{6} inb)
    k0   = zero : [32][8]
    v0   = repeat 0x01 : [32][8]
    k1   = hmac3 k0 (v0 # [0x00] # seed)
    v1   = hmac2 k1 v0
    k2   = hmac3 k1 (v1 # [0x01] # seed)
    v2   = hmac2 k2 v1
    v3   = hmac2 k2 v2
    v4   = hmac2 k2 v3
    v5   = hmac2 k2 v4
    v6   = hmac2 k2 v5
    k3   = hmac2 k2 (v6 # [0x00])
    v7   = hmac2 k3 v6
    v8   = hmac2 k3 v7
    v9   = hmac2 k3 v8
    v10  = hmac2 k3 v9
    v11  = hmac2 k3 v10

// One generate, cut short, so the emit throws away twelve bytes of a block.
drbgRun_48_1_20 : [262][8] -> [20][8]
drbgRun_48_1_20 inb = take`{20} v3
  where
    seed = take`{48} (drop`{6} inb)
    k0   = zero : [32][8]
    v0   = repeat 0x01 : [32][8]
    k1   = hmac3 k0 (v0 # [0x00] # seed)
    v1   = hmac2 k1 v0
    k2   = hmac3 k1 (v1 # [0x01] # seed)
    v2   = hmac2 k2 v1
    v3   = hmac2 k2 v2

// The longest seed the routine allows, a hundred and fifty nine, which puts
// the K step's message at a hundred and ninety two -- the most sha256/hmac
// takes from memory -- and its inner hash at five blocks.
drbgRun_159_1_32 : [262][8] -> [32][8]
drbgRun_159_1_32 inb = v3
  where
    seed = take`{159} (drop`{6} inb)
    k0   = zero : [32][8]
    v0   = repeat 0x01 : [32][8]
    k1   = hmac5 k0 (v0 # [0x00] # seed)
    v1   = hmac2 k1 v0
    k2   = hmac5 k1 (v1 # [0x01] # seed)
    v2   = hmac2 k2 v1
    v3   = hmac2 k2 v2

// ---------------------------------------------------------------------------
// NIST SP 800-185 section 2.3.1: left_encode and right_encode.
//
// The encoding is the shortest big-endian run of bytes holding x, with a count
// of them before (left) or after (right). The count is at least one, so nought
// encodes as two bytes.
//
// leftEncN is written out rather than transcribed per vector, so a vector
// fails if the routine's four-way branch picks the wrong count -- which is the
// only part of this that can be got wrong.
leftEncN : [32] -> [8]
leftEncN x = if x >= 0x01000000 then 4
              | x >= 0x00010000 then 3
              | x >= 0x00000100 then 2
              else 1

// The routine reads x little-endian off the wire; these put it back together.
encVal : [4][8] -> [32]
encVal inb = join (reverse inb)

leftEncRun_1 : [4][8] -> [2][8]
leftEncRun_1 inb = [leftEncN (encVal inb)] # drop`{3} (split`{4} (encVal inb))

leftEncRun_2 : [4][8] -> [3][8]
leftEncRun_2 inb = [leftEncN (encVal inb)] # drop`{2} (split`{4} (encVal inb))

leftEncRun_3 : [4][8] -> [4][8]
leftEncRun_3 inb = [leftEncN (encVal inb)] # drop`{1} (split`{4} (encVal inb))

leftEncRun_4 : [4][8] -> [5][8]
leftEncRun_4 inb = [leftEncN (encVal inb)] # split`{4} (encVal inb)

rightEncRun_1 : [4][8] -> [2][8]
rightEncRun_1 inb = drop`{3} (split`{4} (encVal inb)) # [leftEncN (encVal inb)]

rightEncRun_2 : [4][8] -> [3][8]
rightEncRun_2 inb = drop`{2} (split`{4} (encVal inb)) # [leftEncN (encVal inb)]

rightEncRun_3 : [4][8] -> [4][8]
rightEncRun_3 inb = drop`{1} (split`{4} (encVal inb)) # [leftEncN (encVal inb)]

rightEncRun_4 : [4][8] -> [5][8]
rightEncRun_4 inb = split`{4} (encVal inb) # [leftEncN (encVal inb)]

// ---------------------------------------------------------------------------
// NIST SP 800-185's bytepad of two encoded strings, at SHAKE256's rate:
//
//   bytepad( encode_string(N) || encode_string(S), 136 )
//
// which is what cSHAKE256 and KMAC256 put on the tape ahead of the message.
// The answer is always exactly one block here, which is the routine's own
// stated limit: nlen + slen at most 128.
//
// left_encode of a value needing one byte, and of one needing two. Which is
// wanted per vector follows from the length in the vector's name, and the
// VALUE is computed rather than transcribed, so a wrong length in bits fails.
lencode1 : [8] -> [2][8]
lencode1 x = [1, x]

lencode2 : [16] -> [3][8]
lencode2 x = [2] # split x

bp136Run_0_0 : [260][8] -> [136][8]
bp136Run_0_0 inb = lencode1 136 # lencode1 (8 * 0) # lencode1 (8 * 0)
                 # (zero : [130][8])

bp136Run_4_0 : [260][8] -> [136][8]
bp136Run_4_0 inb = lencode1 136 # lencode1 (8 * 4) # take`{4} (drop`{4} inb)
                 # lencode1 (8 * 0) # (zero : [126][8])

bp136Run_4_21 : [260][8] -> [136][8]
bp136Run_4_21 inb = lencode1 136 # lencode1 (8 * 4) # take`{4} (drop`{4} inb)
                  # lencode1 (8 * 21) # take`{21} (drop`{132} inb)
                  # (zero : [105][8])

bp136Run_0_15 : [260][8] -> [136][8]
bp136Run_0_15 inb = lencode1 136 # lencode1 (8 * 0)
                  # lencode1 (8 * 15) # take`{15} (drop`{132} inb)
                  # (zero : [115][8])

// Both strings at thirty one bytes, so both lengths in bits are 248 and both
// encodings are still one byte -- the last size at which that is true.
bp136Run_31_31 : [260][8] -> [136][8]
bp136Run_31_31 inb = lencode1 136 # lencode1 (8 * 31) # take`{31} (drop`{4} inb)
                   # lencode1 (8 * 31) # take`{31} (drop`{132} inb)
                   # (zero : [68][8])

// The limit: thirty two and ninety six, so both lengths in bits need two
// bytes and the block comes out EXACTLY full with no padding at all.
bp136Run_32_96 : [260][8] -> [136][8]
bp136Run_32_96 inb = lencode1 136 # lencode2 (8 * 32) # take`{32} (drop`{4} inb)
                   # lencode2 (8 * 96) # take`{96} (drop`{132} inb)

// The same at SHAKE128's rate. A separate set of entries rather than one
// parameterised by the rate, because the routine is a separate file for the
// same reason: the rate sets the size of the block.
bp168Run_0_0 : [260][8] -> [168][8]
bp168Run_0_0 inb = lencode1 168 # lencode1 (8 * 0) # lencode1 (8 * 0)
                 # (zero : [162][8])

bp168Run_4_0 : [260][8] -> [168][8]
bp168Run_4_0 inb = lencode1 168 # lencode1 (8 * 4) # take`{4} (drop`{4} inb)
                 # lencode1 (8 * 0) # (zero : [158][8])

bp168Run_4_21 : [260][8] -> [168][8]
bp168Run_4_21 inb = lencode1 168 # lencode1 (8 * 4) # take`{4} (drop`{4} inb)
                  # lencode1 (8 * 21) # take`{21} (drop`{132} inb)
                  # (zero : [137][8])

bp168Run_0_15 : [260][8] -> [168][8]
bp168Run_0_15 inb = lencode1 168 # lencode1 (8 * 0)
                  # lencode1 (8 * 15) # take`{15} (drop`{132} inb)
                  # (zero : [147][8])

// The limit at this rate: sixty four and ninety six, both lengths in bits
// needing two bytes, and the block exactly full with no padding.
bp168Run_64_96 : [260][8] -> [168][8]
bp168Run_64_96 inb = lencode1 168 # lencode2 (8 * 64) # take`{64} (drop`{4} inb)
                   # lencode2 (8 * 96) # take`{96} (drop`{132} inb)

// ---------------------------------------------------------------------------
// SHA-512's tables and its compression function. Written out from FIPS 180-4
// rather than taken from Cryptol's library, for the reason SHA-256 was: oracle
// B has to be independent of whatever the toolchain ships.

sha512K : [80][64]
sha512K =
  [
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
  ]

sha512H0 : [8][64]
sha512H0 =
  [
     0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
     0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179
  ]

sha512Sig0 : [64] -> [64]
sha512Sig0 x = (x >>> 1) ^ (x >>> 8) ^ (x >> 7)

sha512Sig1 : [64] -> [64]
sha512Sig1 x = (x >>> 19) ^ (x >>> 61) ^ (x >> 6)

// The sliding window the brainfuck keeps, exactly as for SHA-256: sixteen
// words, four fixed taps, one new word appended.
sha512SchedStep : [16][64] -> [16][64]
sha512SchedStep w = drop`{1} w # [nw]
  where
    nw = sha512Sig1 (w @ (14 : [8])) + (w @ (9 : [8]))
       + sha512Sig0 (w @ (1  : [8])) + (w @ (0 : [8]))

sha512Sched : [16][64] -> [80][64]
sha512Sched m = m # [ w @ (15 : [8]) | w <- take`{64} (drop`{1} wins) ]
  where
    wins = [m] # [ sha512SchedStep w | w <- wins ]

sha512Words : [128][8] -> [16][64]
sha512Words blk = [ join grp | grp <- split`{16} blk ]

sha512Compress : [8][64] -> [128][8] -> [8][64]
sha512Compress hin blk = [ x + y | x <- hin | y <- vs @ (80 : [8]) ]
  where
    ws = sha512Sched (sha512Words blk)
    vs = [hin] # [ sha512Step v kt wt | v <- vs | kt <- sha512K | wt <- ws ]

sha512Out : [8][64] -> [64][8]
sha512Out h = join [ split w | w <- h ]

// Padding: a ONE bit, then zeros, then the length in BITS as a big endian
// HUNDRED AND TWENTY EIGHT bit number, filling out whole blocks of 128.
sha512Pad1 : {n} (fin n, n <= 111) => [n][8] -> [128][8]
sha512Pad1 m = m # [0x80] # (zero : [111 - n][8]) # split (`(8 * n) : [128])

sha512Pad2 : {n} (fin n, n >= 112, n <= 239) => [n][8] -> [256][8]
sha512Pad2 m = m # [0x80] # (zero : [239 - n][8]) # split (`(8 * n) : [128])


// SHA-512 over the wire, as sha512/sha512.bf reads it: len(2 LE) then the
// message. One Run per length, because Cryptol's padding is indexed by it.

sha512Run_0 : [2][8] -> [64][8]
sha512Run_0 inb =
    sha512Out (sha512Compress sha512H0 (sha512Pad1`{0} (drop`{2} inb)))

sha512Run_1 : [3][8] -> [64][8]
sha512Run_1 inb =
    sha512Out (sha512Compress sha512H0 (sha512Pad1`{1} (drop`{2} inb)))

sha512Run_3 : [5][8] -> [64][8]
sha512Run_3 inb =
    sha512Out (sha512Compress sha512H0 (sha512Pad1`{3} (drop`{2} inb)))

sha512Run_56 : [58][8] -> [64][8]
sha512Run_56 inb =
    sha512Out (sha512Compress sha512H0 (sha512Pad1`{56} (drop`{2} inb)))

sha512Run_111 : [113][8] -> [64][8]
sha512Run_111 inb =
    sha512Out (sha512Compress sha512H0 (sha512Pad1`{111} (drop`{2} inb)))

sha512Run_112 : [114][8] -> [64][8]
sha512Run_112 inb = sha512Out h2
  where
    p  = sha512Pad2`{112} (drop`{2} inb)
    h1 = sha512Compress sha512H0 (take`{128} p)
    h2 = sha512Compress h1 (drop`{128} p)

sha512Run_128 : [130][8] -> [64][8]
sha512Run_128 inb = sha512Out h2
  where
    p  = sha512Pad2`{128} (drop`{2} inb)
    h1 = sha512Compress sha512H0 (take`{128} p)
    h2 = sha512Compress h1 (drop`{128} p)

// ==== SHA-384 and both SHA-512/t: the same compression, eight other words ====
//
// This model was already parameterised by the initial words -- sha512Compress
// takes them -- so a variant is a constant and a truncation and nothing else.
// The brainfuck reached the same shape from the other end: sha512/hashcore
// leaves H alone when the caller raises the flag at @0x21a, and each head
// carries its own eight.
//
// THE SHA-512/256 WORDS WERE DERIVED, NOT TRANSCRIBED, and that is why they
// are right: one of them was typed from memory first and had a single bit
// wrong in H4, which the third party caught. FIPS 180-4 section 5.3.6 defines
// them as SHA-512 of "SHA-512/t" under an IV of SHA-512's own words each
// exclusive ored with 0xa5a5a5a5a5a5a5a5.

sha384H0 : [8][64]
sha384H0 =
    [ 0xcbbb9d5dc1059ed8
    , 0x629a292a367cd507
    , 0x9159015a3070dd17
    , 0x152fecd8f70e5939
    , 0x67332667ffc00b31
    , 0x8eb44a8768581511
    , 0xdb0c2e0d64f98fa7
    , 0x47b5481dbefa4fa4
    ]

sha512_224H0 : [8][64]
sha512_224H0 =
    [ 0x8c3d37c819544da2
    , 0x73e1996689dcd4d6
    , 0x1dfab7ae32ff9c82
    , 0x679dd514582f9fcf
    , 0x0f6d2b697bd44da8
    , 0x77e36f7304c48942
    , 0x3f9d85a86a1d36c8
    , 0x1112e6ad91d692a1
    ]

sha512_256H0 : [8][64]
sha512_256H0 =
    [ 0x22312194fc2bf72c
    , 0x9f555fa3c84c64c2
    , 0x2393b86b6f53b151
    , 0x963877195940eabd
    , 0x96283ee2a88effe3
    , 0xbe5e1e2553863992
    , 0x2b0199fc2c85b8aa
    , 0x0eb72ddc81c52ca2
    ]

// The digest is the front of the eight words: 48 bytes for SHA-384, 28 for
// SHA-512/224 and 32 for SHA-512/256.
sha512Trunc : {d} (fin d, d <= 64) => [8][64] -> [d][8]
sha512Trunc h = take`{d} (sha512Out h)

// sha384 over the wire: len(2 LE) then the message.
sha384Run_0 : [2][8] -> [48][8]
sha384Run_0 inb =
    sha512Trunc`{48} (sha512Compress sha384H0 (sha512Pad1`{0} (drop`{2} inb)))
sha384Run_3 : [5][8] -> [48][8]
sha384Run_3 inb =
    sha512Trunc`{48} (sha512Compress sha384H0 (sha512Pad1`{3} (drop`{2} inb)))
sha384Run_111 : [113][8] -> [48][8]
sha384Run_111 inb =
    sha512Trunc`{48} (sha512Compress sha384H0 (sha512Pad1`{111} (drop`{2} inb)))
sha384Run_112 : [114][8] -> [48][8]
sha384Run_112 inb = sha512Trunc`{48} h2
  where
    p  = sha512Pad2`{112} (drop`{2} inb)
    h1 = sha512Compress sha384H0 (take`{128} p)
    h2 = sha512Compress h1 (drop`{128} p)

// sha512_224 over the wire: len(2 LE) then the message.
sha512_224Run_0 : [2][8] -> [28][8]
sha512_224Run_0 inb =
    sha512Trunc`{28} (sha512Compress sha512_224H0 (sha512Pad1`{0} (drop`{2} inb)))
sha512_224Run_3 : [5][8] -> [28][8]
sha512_224Run_3 inb =
    sha512Trunc`{28} (sha512Compress sha512_224H0 (sha512Pad1`{3} (drop`{2} inb)))
sha512_224Run_111 : [113][8] -> [28][8]
sha512_224Run_111 inb =
    sha512Trunc`{28} (sha512Compress sha512_224H0 (sha512Pad1`{111} (drop`{2} inb)))
sha512_224Run_112 : [114][8] -> [28][8]
sha512_224Run_112 inb = sha512Trunc`{28} h2
  where
    p  = sha512Pad2`{112} (drop`{2} inb)
    h1 = sha512Compress sha512_224H0 (take`{128} p)
    h2 = sha512Compress h1 (drop`{128} p)

// sha512_256 over the wire: len(2 LE) then the message.
sha512_256Run_0 : [2][8] -> [32][8]
sha512_256Run_0 inb =
    sha512Trunc`{32} (sha512Compress sha512_256H0 (sha512Pad1`{0} (drop`{2} inb)))
sha512_256Run_3 : [5][8] -> [32][8]
sha512_256Run_3 inb =
    sha512Trunc`{32} (sha512Compress sha512_256H0 (sha512Pad1`{3} (drop`{2} inb)))
sha512_256Run_111 : [113][8] -> [32][8]
sha512_256Run_111 inb =
    sha512Trunc`{32} (sha512Compress sha512_256H0 (sha512Pad1`{111} (drop`{2} inb)))
sha512_256Run_112 : [114][8] -> [32][8]
sha512_256Run_112 inb = sha512Trunc`{32} h2
  where
    p  = sha512Pad2`{112} (drop`{2} inb)
    h1 = sha512Compress sha512_256H0 (take`{128} p)
    h2 = sha512Compress h1 (drop`{128} p)

// sha512/hashcore.bf takes a prefix from memory and then a count from the
// wire; one Run per pair of counts, named for them.

hashcore512Run_0_3 : [263][8] -> [64][8]
hashcore512Run_0_3 inb = sha512Out (hs @ (1 : [8]))
  where
    msg = take`{0} (drop`{4} inb) # drop`{260} inb
    hs  = [sha512H0] # [ sha512Compress h b
                       | h <- hs | b <- split`{1} (sha512Pad1`{3} msg) ]

hashcore512Run_3_0 : [260][8] -> [64][8]
hashcore512Run_3_0 inb = sha512Out (hs @ (1 : [8]))
  where
    msg = take`{3} (drop`{4} inb) # drop`{260} inb
    hs  = [sha512H0] # [ sha512Compress h b
                       | h <- hs | b <- split`{1} (sha512Pad1`{3} msg) ]

hashcore512Run_1_2 : [262][8] -> [64][8]
hashcore512Run_1_2 inb = sha512Out (hs @ (1 : [8]))
  where
    msg = take`{1} (drop`{4} inb) # drop`{260} inb
    hs  = [sha512H0] # [ sha512Compress h b
                       | h <- hs | b <- split`{1} (sha512Pad1`{3} msg) ]

hashcore512Run_0_0 : [260][8] -> [64][8]
hashcore512Run_0_0 inb = sha512Out (hs @ (1 : [8]))
  where
    msg = take`{0} (drop`{4} inb) # drop`{260} inb
    hs  = [sha512H0] # [ sha512Compress h b
                       | h <- hs | b <- split`{1} (sha512Pad1`{0} msg) ]

hashcore512Run_128_0 : [260][8] -> [64][8]
hashcore512Run_128_0 inb = sha512Out (hs @ (2 : [8]))
  where
    msg = take`{128} (drop`{4} inb) # drop`{260} inb
    hs  = [sha512H0] # [ sha512Compress h b
                       | h <- hs | b <- split`{2} (sha512Pad2`{128} msg) ]

hashcore512Run_60_68 : [328][8] -> [64][8]
hashcore512Run_60_68 inb = sha512Out (hs @ (2 : [8]))
  where
    msg = take`{60} (drop`{4} inb) # drop`{260} inb
    hs  = [sha512H0] # [ sha512Compress h b
                       | h <- hs | b <- split`{2} (sha512Pad2`{128} msg) ]

// HMAC-SHA-512, RFC 2104: H( (K xor opad) then H( (K xor ipad) then message ) )
// with K the key padded to a block of a HUNDRED AND TWENTY EIGHT, or the key's
// own SHA-512 if it was longer than one. Only the two pads are new; both
// hashes are ordinary SHA-512 over a byte string.
hmac512Ipad : [128][8] -> [128][8]
hmac512Ipad kpad = [ k ^ 0x36 | k <- kpad ]

hmac512Opad : [128][8] -> [128][8]
hmac512Opad kpad = [ k ^ 0x5c | k <- kpad ]

hmac512Run_20_0_8 : [526][8] -> [64][8]
hmac512Run_20_0_8 inb = sha512Out (hOut @ (2 : [8]))
  where
    kpad = take`{20} (drop`{6} inb) # (zero : [108][8])
    msg  = drop`{518} inb
    inn  = sha512Out (hIn @ (2 : [8]))
    hIn  = [sha512H0] # [ sha512Compress h b | h <- hIn
                        | b <- split`{2} (sha512Pad2`{136} (hmac512Ipad kpad # msg)) ]
    hOut = [sha512H0] # [ sha512Compress h b | h <- hOut
                        | b <- split`{2} (sha512Pad2`{192} (hmac512Opad kpad # inn)) ]

hmac512Run_20_8_0 : [518][8] -> [64][8]
hmac512Run_20_8_0 inb = sha512Out (hOut @ (2 : [8]))
  where
    kpad = take`{20} (drop`{6} inb) # (zero : [108][8])
    msg  = take`{8} (drop`{262} inb)
    inn  = sha512Out (hIn @ (2 : [8]))
    hIn  = [sha512H0] # [ sha512Compress h b | h <- hIn
                        | b <- split`{2} (sha512Pad2`{136} (hmac512Ipad kpad # msg)) ]
    hOut = [sha512H0] # [ sha512Compress h b | h <- hOut
                        | b <- split`{2} (sha512Pad2`{192} (hmac512Opad kpad # inn)) ]

hmac512Run_4_0_28 : [546][8] -> [64][8]
hmac512Run_4_0_28 inb = sha512Out (hOut @ (2 : [8]))
  where
    kpad = take`{4} (drop`{6} inb) # (zero : [124][8])
    msg  = drop`{518} inb
    inn  = sha512Out (hIn @ (2 : [8]))
    hIn  = [sha512H0] # [ sha512Compress h b | h <- hIn
                        | b <- split`{2} (sha512Pad2`{156} (hmac512Ipad kpad # msg)) ]
    hOut = [sha512H0] # [ sha512Compress h b | h <- hOut
                        | b <- split`{2} (sha512Pad2`{192} (hmac512Opad kpad # inn)) ]

hmac512Run_20_0_50 : [568][8] -> [64][8]
hmac512Run_20_0_50 inb = sha512Out (hOut @ (2 : [8]))
  where
    kpad = take`{20} (drop`{6} inb) # (zero : [108][8])
    msg  = drop`{518} inb
    inn  = sha512Out (hIn @ (2 : [8]))
    hIn  = [sha512H0] # [ sha512Compress h b | h <- hIn
                        | b <- split`{2} (sha512Pad2`{178} (hmac512Ipad kpad # msg)) ]
    hOut = [sha512H0] # [ sha512Compress h b | h <- hOut
                        | b <- split`{2} (sha512Pad2`{192} (hmac512Opad kpad # inn)) ]

hmac512Run_0_0_0 : [518][8] -> [64][8]
hmac512Run_0_0_0 inb = sha512Out (hOut @ (2 : [8]))
  where
    kpad = (zero : [128][8])
    msg  = ([] : [0][8])
    inn  = sha512Out (hIn @ (2 : [8]))
    hIn  = [sha512H0] # [ sha512Compress h b | h <- hIn
                        | b <- split`{2} (sha512Pad2`{128} (hmac512Ipad kpad # msg)) ]
    hOut = [sha512H0] # [ sha512Compress h b | h <- hOut
                        | b <- split`{2} (sha512Pad2`{192} (hmac512Opad kpad # inn)) ]

hmac512Run_131_0_54 : [572][8] -> [64][8]
hmac512Run_131_0_54 inb = sha512Out (hOut @ (2 : [8]))
  where
    kh   = sha512Out (hk @ (2 : [8]))
    hk   = [sha512H0] # [ sha512Compress h b | h <- hk
                        | b <- split`{2} (sha512Pad2`{131} (take`{131} (drop`{6} inb))) ]
    kpad = kh # (zero : [64][8])
    msg  = drop`{518} inb
    inn  = sha512Out (hIn @ (2 : [8]))
    hIn  = [sha512H0] # [ sha512Compress h b | h <- hIn
                        | b <- split`{2} (sha512Pad2`{182} (hmac512Ipad kpad # msg)) ]
    hOut = [sha512H0] # [ sha512Compress h b | h <- hOut
                        | b <- split`{2} (sha512Pad2`{192} (hmac512Opad kpad # inn)) ]

hmac512Run_128_0_26 : [544][8] -> [64][8]
hmac512Run_128_0_26 inb = sha512Out (hOut @ (2 : [8]))
  where
    kpad = take`{128} (drop`{6} inb)
    msg  = drop`{518} inb
    inn  = sha512Out (hIn @ (2 : [8]))
    hIn  = [sha512H0] # [ sha512Compress h b | h <- hIn
                        | b <- split`{2} (sha512Pad2`{154} (hmac512Ipad kpad # msg)) ]
    hOut = [sha512H0] # [ sha512Compress h b | h <- hOut
                        | b <- split`{2} (sha512Pad2`{192} (hmac512Opad kpad # inn)) ]

// Padding to three blocks, which HKDF-SHA-512 needs when its info is long:
// the expand message is T then info then the counter, sixty four plus sixty
// three plus one is a hundred and twenty eight, and with the pad block in
// front of it that comes to two hundred and fifty six.
sha512Pad3 : {n} (fin n, n >= 240, n <= 367) => [n][8] -> [384][8]
sha512Pad3 m = m # [0x80] # (zero : [367 - n][8]) # split (`(8 * n) : [128])

// A fourth block of padding, which the longest info this routine allows needs
// on the second turn of expand: sixty four bytes of T, a hundred and ninety of
// info and the counter byte, under a block of key pad.
sha512Pad4 : {n} (fin n, n >= 368, n <= 495) => [n][8] -> [512][8]
sha512Pad4 m = m # [0x80] # (zero : [495 - n][8]) # split (`(8 * n) : [128])

// A prefix of 129 bytes, which is one past what the prefix slide in
// sha512/hashcore used to reach: the buffer was widened to 448 cells and the
// slide that consumes it was still stepping 255 times, so every byte past the
// 256th read as nought. This vector is one byte over that edge and the
// cheapest place in the tree to see it.
hmac512Run_20_129_0 : [518][8] -> [64][8]
hmac512Run_20_129_0 inb = sha512Out (hOut @ (2 : [8]))
  where
    kpad = take`{20} (drop`{6} inb) # (zero : [108][8])
    msg  = take`{129} (drop`{262} inb)
    inn  = sha512Out (hIn @ (3 : [8]))
    hIn  = [sha512H0] # [ sha512Compress h b | h <- hIn
                        | b <- split`{3} (sha512Pad3`{257} (hmac512Ipad kpad # msg)) ]
    hOut = [sha512H0] # [ sha512Compress h b | h <- hOut
                        | b <- split`{2} (sha512Pad2`{192} (hmac512Opad kpad # inn)) ]

// And the whole of mbuf, which is the most a caller can hand over in memory
// and puts the inner hash at four blocks.
hmac512Run_20_256_0 : [518][8] -> [64][8]
hmac512Run_20_256_0 inb = sha512Out (hOut @ (2 : [8]))
  where
    kpad = take`{20} (drop`{6} inb) # (zero : [108][8])
    msg  = take`{256} (drop`{262} inb)
    inn  = sha512Out (hIn @ (4 : [8]))
    hIn  = [sha512H0] # [ sha512Compress h b | h <- hIn
                        | b <- split`{4} (sha512Pad4`{384} (hmac512Ipad kpad # msg)) ]
    hOut = [sha512H0] # [ sha512Compress h b | h <- hOut
                        | b <- split`{2} (sha512Pad2`{192} (hmac512Opad kpad # inn)) ]

// HMAC-SHA-512 where both hashes come to two blocks. Polymorphic in the key
// and message lengths, so one definition serves extract and every turn of
// expand, exactly as hmac2 does for SHA-256.
hmac512two : {kn, mn} (fin kn, fin mn, kn <= 128, mn <= 111) =>
             [kn][8] -> [mn][8] -> [64][8]
hmac512two key msg = sha512Out (hOut @ (2 : [8]))
  where
    kpad = key # (zero : [128 - kn][8])
    inn  = sha512Out (hIn @ (2 : [8]))
    hIn  = [sha512H0] # [ sha512Compress h b | h <- hIn
                        | b <- split`{2} (sha512Pad2`{128 + mn} (hmac512Ipad kpad # msg)) ]
    hOut = [sha512H0] # [ sha512Compress h b | h <- hOut
                        | b <- split`{2} (sha512Pad2`{192} (hmac512Opad kpad # inn)) ]

// And the same where the inner message runs to three blocks, which the
// longest info this routine allows needs.
hmac512three : {kn, mn} (fin kn, fin mn, kn <= 128, mn >= 112, mn <= 239) =>
               [kn][8] -> [mn][8] -> [64][8]
hmac512three key msg = sha512Out (hOut @ (2 : [8]))
  where
    kpad = key # (zero : [128 - kn][8])
    inn  = sha512Out (hIn @ (3 : [8]))
    hIn  = [sha512H0] # [ sha512Compress h b | h <- hIn
                        | b <- split`{3} (sha512Pad3`{128 + mn} (hmac512Ipad kpad # msg)) ]
    hOut = [sha512H0] # [ sha512Compress h b | h <- hOut
                        | b <- split`{2} (sha512Pad2`{192} (hmac512Opad kpad # inn)) ]

// And at four, which is where a hundred and ninety bytes of info puts the
// second turn.
hmac512four : {kn, mn} (fin kn, fin mn, kn <= 128, mn >= 240, mn <= 367) =>
              [kn][8] -> [mn][8] -> [64][8]
hmac512four key msg = sha512Out (hOut @ (2 : [8]))
  where
    kpad = key # (zero : [128 - kn][8])
    inn  = sha512Out (hIn @ (4 : [8]))
    hIn  = [sha512H0] # [ sha512Compress h b | h <- hIn
                        | b <- split`{4} (sha512Pad4`{128 + mn} (hmac512Ipad kpad # msg)) ]
    hOut = [sha512H0] # [ sha512Compress h b | h <- hOut
                        | b <- split`{2} (sha512Pad2`{192} (hmac512Opad kpad # inn)) ]

// RFC 5869 A.1's shape at SHA-512: a thirteen byte salt, twenty two of keying
// material, ten of info, forty two bytes out. Two turns of expand, the second
// truncated.
hkdf512Run_13_22_10_42 : [776][8] -> [42][8]
hkdf512Run_13_22_10_42 inb = take`{42} (t1 # t2)
  where
    salt = take`{13} (drop`{8} inb)
    ikm  = take`{22} (drop`{264} inb)
    info = take`{10} (drop`{520} inb)
    prk  = hmac512two salt ikm
    t1   = hmac512two prk (info # [1])
    t2   = hmac512two prk (t1 # info # [2])

// A.3's shape: no salt and no info. RFC 5869 says an absent salt is HashLen
// noughts, which for SHA-512 is sixty four of them; that is not the same as a
// key of length nought and the distinction is the whole of this vector.
hkdf512Run_0_22_0_42 : [776][8] -> [42][8]
hkdf512Run_0_22_0_42 inb = take`{42} (t1 # t2)
  where
    ikm = take`{22} (drop`{264} inb)
    prk = hmac512two (zero : [64][8]) ikm
    t1  = hmac512two prk ([1] : [1][8])
    t2  = hmac512two prk (t1 # [2])

// One byte of output, which is the whole of the first T thrown away but for
// its head; the cut short path with nothing left over to hide a mistake.
hkdf512Run_0_22_0_1 : [776][8] -> [1][8]
hkdf512Run_0_22_0_1 inb = take`{1} t1
  where
    ikm = take`{22} (drop`{264} inb)
    prk = hmac512two (zero : [64][8]) ikm
    t1  = hmac512two prk ([1] : [1][8])

// A salt of a hundred and forty bytes, LONGER than SHA-512's block, so HMAC
// hashes it first; and the longest info this routine allows, sixty three,
// which is what pushes the second turn's inner hash to three blocks. Two
// whole T values out and nothing truncated.
hkdf512Run_140_22_63_128 : [776][8] -> [128][8]
hkdf512Run_140_22_63_128 inb = t1 # t2
  where
    salt = take`{140} (drop`{8} inb)
    ikm  = take`{22} (drop`{264} inb)
    info = take`{63} (drop`{520} inb)
    skey = sha512Out (hS @ (2 : [8]))
    hS   = [sha512H0] # [ sha512Compress h b | h <- hS
                        | b <- split`{2} (sha512Pad2`{140} salt) ]
    prk  = hmac512two skey ikm
    t1   = hmac512two prk (info # [1])
    t2   = hmac512three prk (t1 # info # [2])

// Sixty four bytes of info, which is one past the limit this file had before
// three buffers were widened; the first vector that could not have run at all
// on the old shape.
hkdf512Run_13_22_64_42 : [776][8] -> [42][8]
hkdf512Run_13_22_64_42 inb = take`{42} (t1 # t2)
  where
    salt = take`{13} (drop`{8} inb)
    ikm  = take`{22} (drop`{264} inb)
    info = take`{64} (drop`{520} inb)
    prk  = hmac512two salt ikm
    t1   = hmac512two prk (info # [1])
    t2   = hmac512three prk (t1 # info # [2])

// A hundred and twenty eight bytes of info, which puts both turns at three
// blocks and is the middle of the new range rather than either end of it.
hkdf512Run_13_22_128_42 : [776][8] -> [42][8]
hkdf512Run_13_22_128_42 inb = take`{42} (t1 # t2)
  where
    salt = take`{13} (drop`{8} inb)
    ikm  = take`{22} (drop`{264} inb)
    info = take`{128} (drop`{520} inb)
    prk  = hmac512two salt ikm
    t1   = hmac512three prk (info # [1])
    t2   = hmac512three prk (t1 # info # [2])

// A hundred and ninety, the most this routine allows: T and info and the
// counter byte together are two hundred and fifty five, one short of the
// message buffer, and the second turn's inner hash runs to four blocks.
hkdf512Run_13_22_190_128 : [776][8] -> [128][8]
hkdf512Run_13_22_190_128 inb = t1 # t2
  where
    salt = take`{13} (drop`{8} inb)
    ikm  = take`{22} (drop`{264} inb)
    info = take`{190} (drop`{520} inb)
    prk  = hmac512two salt ikm
    t1   = hmac512three prk (info # [1])
    t2   = hmac512four prk (t1 # info # [2])
