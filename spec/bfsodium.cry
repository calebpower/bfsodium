// bfsodium reference oracle (Cryptol).
//
// This is oracle B: a bit-precise, independent specification the brainfuck is
// checked against, byte-for-byte, alongside the published standard vectors
// (oracle A). Each `*Run` function takes and returns the exact wire bytes a
// bfsodium primitive reads on stdin and writes on stdout, so the driver can
// compare raw byte sequences with no marshaling of its own. The little-endian
// word handling lives here on purpose: it means the tests also prove the
// brainfuck's LE handling matches the spec.

module bfsodium where

// Little-endian conversion for a number of any byte width. Poly1305 works on
// 130-bit values, which are 17 bytes on the wire, so the 32-bit helpers below
// are not enough on their own.
leN : {n} (fin n) => [n][8] -> [n * 8]
leN bs = join (reverse bs)

leBytesN : {n} (fin n) => [n * 8] -> [n][8]
leBytesN w = reverse (split w)

// ADDN: in = a(n LE) # b(n LE); out = (a + b mod 2^(8n))(n LE).
// Exercised at 17 bytes, the width the Poly1305 accumulator needs.
add136Run : [34][8] -> [17][8]
add136Run inb = leBytesN`{17} (leN (take`{17} inb) + leN (drop`{17} inb))

// HALVEN: in = x(17 LE); out = (x >> 1)(17 LE).
halve136Run : [17][8] -> [17][8]
halve136Run inb = leBytesN`{17} (leN inb >> 1)

// FOLD: one reduction step using 2^130 = 5 (mod 2^130 - 5).
// in = x(17 LE); out = (L + 5H)(17 LE) where x = L + H*2^130.
fold136Run : [17][8] -> [17][8]
fold136Run inb = leBytesN`{17} (lo + 5 * hi)
  where
    x  = leN inb
    hi = x >> 130
    lo = x && ((1 << 130) - 1)

// REDUCEP: in = x(17 LE); out = (x mod p)(17 LE) where p = 2^130 - 5.
reducep136Run : [17][8] -> [17][8]
reducep136Run inb = leBytesN`{17} (leN inb % ((1 << 130) - 5))

// MULMOD: in = a(17 LE) # r(17 LE); out = (a * r mod p)(17 LE), p = 2^130 - 5.
// Computed in a wider type so the product is not truncated before reduction.
mulmod136Run : [34][8] -> [17][8]
mulmod136Run inb = leBytesN`{17} (drop`{136} prod)
  where
    a    = (zero # leN (take`{17} inb)) : [272]
    r    = (zero # leN (drop`{17} inb)) : [272]
    pp   = ((1 : [272]) << 130) - 5
    prod = (a * r) % pp

// A 32-bit word is four little-endian bytes on the wire (LSB first).
leWord : [4][8] -> [32]
leWord bs = join (reverse bs)

leBytes : [32] -> [4][8]
leBytes w = reverse (split w)

// ADD32: in = a(4 LE) # b(4 LE); out = (a + b mod 2^32)(4 LE).
add32Run : [8][8] -> [4][8]
add32Run inb = leBytes (leWord (take`{4} inb) + leWord (drop`{4} inb))

// ROTL32 by n: in = w(4 LE); out = (w <<< n)(4 LE).
rotl32Run : [8] -> [4][8] -> [4][8]
rotl32Run n inb = leBytes (leWord inb <<< n)

// ROTL32 with the rotation count supplied on the wire, as chacha20/rotl32.bf
// reads it: in = w(4 LE) # n(1); out = (w <<< n)(4 LE).
rotl32nRun : [5][8] -> [4][8]
rotl32nRun inb = leBytes (leWord (take`{4} inb) <<< (inb @ 4))

// XOR32: in = x(4 LE) # y(4 LE); out = (x ^ y)(4 LE).
xor32Run : [8][8] -> [4][8]
xor32Run inb = leBytes (leWord (take`{4} inb) ^ leWord (drop`{4} inb))

// The quarter round on four words.
qr4 : ([32],[32],[32],[32]) -> ([32],[32],[32],[32])
qr4 (a,b,c,d) = (a2,b2,c2,d2)
  where
    a1 = a  + b
    d1 = (d  ^ a1) <<< 16
    c1 = c  + d1
    b1 = (b  ^ c1) <<< 12
    a2 = a1 + b1
    d2 = (d1 ^ a2) <<< 8
    c2 = c1 + d2
    b2 = (b1 ^ c2) <<< 7

applyQR : [16][32] -> ([8],[8],[8],[8]) -> [16][32]
applyQR s (i,j,k,l) =
    update (update (update (update s i a') j b') k c') l d'
  where (a',b',c',d') = qr4 (s@i, s@j, s@k, s@l)

doubleRound : [16][32] -> [16][32]
doubleRound s = foldl applyQR s
    [ (0,4,8,12), (1,5,9,13), (2,6,10,14), (3,7,11,15)
    , (0,5,10,15),(1,6,11,12),(2,7,8,13), (3,4,9,14) ]

// The ChaCha20 block function (RFC 8439 section 2.3), taking and returning the
// exact wire bytes chacha20/block.bf reads and writes:
// in = key(32) # counter(4 LE) # nonce(12); out = the 64 byte keystream block.
blockRun : [48][8] -> [64][8]
blockRun inb = chachaBlock (take`{32} inb) (leWord (take`{4} (drop`{32} inb)))
                           (drop`{36} inb)

// The block function proper, on parts rather than wire bytes, so the stream
// cipher can call it once per 64 byte block.
chachaBlock : [32][8] -> [32] -> [12][8] -> [64][8]
chachaBlock key ctr non = join [ leBytes w | w <- out ]
  where
    kws  = [ leWord w | w <- split`{8} key ]
    nws  = [ leWord w | w <- split`{3} non ]
    st0  = [0x61707865, 0x3320646e, 0x79622d32, 0x6b206574] # kws # [ctr] # nws
    sts  = [st0] # [ doubleRound s | s <- sts ]
    out  = [ x + y | x <- sts @ (10 : [8]) | y <- st0 ]

// The ChaCha20 stream cipher (RFC 8439 section 2.4), taking and returning the
// exact wire bytes chacha20/stream.bf reads and writes:
//   in  = key(32) # counter(4 LE) # nonce(12) # len(2 LE) # plaintext(len)
//   out = ciphertext(len)
// The length prefix is what the brainfuck uses to know when to stop, since a
// primitive here never relies on end of input (CONVENTIONS section 7).
streamRun : {n} (fin n, 64 >= width n) => [50 + n][8] -> [n][8]
streamRun inb = [ p ^ k | p <- ptext | k <- ks ]
  where
    key   = take`{32} inb
    ctr   = leWord (take`{4} (drop`{32} inb))
    non   = take`{12} (drop`{36} inb)
    ptext = drop`{50} inb
    ks    = take`{n} (join [ chachaBlock key (ctr + i) non
                           | i <- [0 ...] : [_][32] ])

// The ChaCha20 quarter round (RFC 8439 section 2.2.1).
// in = a # b # c # d, each 4 LE bytes; out = the same four words, updated.
qrRun : [16][8] -> [16][8]
qrRun inb = leBytes a2 # leBytes b2 # leBytes c2 # leBytes d2
  where
    ws = [ leWord w | w <- split`{4} inb ]
    a  = ws @ (0 : [8])
    b  = ws @ (1 : [8])
    c  = ws @ (2 : [8])
    d  = ws @ (3 : [8])
    a1 = a  + b
    d1 = (d  ^ a1) <<< 16
    c1 = c  + d1
    b1 = (b  ^ c1) <<< 12
    a2 = a1 + b1
    d2 = (d1 ^ a2) <<< 8
    c2 = c1 + d2
    b2 = (b1 ^ c2) <<< 7

// Poly1305 (RFC 8439 section 2.5) over a 34 byte message, which is the size of
// the section 2.5.2 vector: two full blocks and a two byte tail.
//   in = key(32) # len(2 LE) # msg(34); out = tag(16)
// Written out block by block rather than folded, so it stays readable and
// stays independent of how the brainfuck loops.
wide : {k} (fin k, 272 >= k) => [k] -> [272]
wide x = zero # x

poly1305Run34 : [68][8] -> [16][8]
poly1305Run34 inb = leBytesN`{16} (drop`{144} ((a2 + s) && ((1 << 128) - 1)))
  where
    key = take`{32} inb
    msg = drop`{34} inb
    r   = wide (leN (take`{16} key) && 0x0ffffffc0ffffffc0ffffffc0fffffff)
    s   = wide (leN (drop`{16} key))
    pp  = ((1 : [272]) << 130) - 5
    b0  = wide (leN (take`{16} msg))              + (1 << 128)
    b1  = wide (leN (take`{16} (drop`{16} msg)))  + (1 << 128)
    b2  = wide (leN (drop`{32} msg))              + (1 << 16)
    a0  = ((0  + b0) * r) % pp
    a1  = ((a0 + b1) * r) % pp
    a2  = ((a1 + b2) * r) % pp

// ROWROT: rotate each of the four rows of a ChaCha state left by one word.
// This is what makes every column quarter round land on the same four words,
// so the block function needs no indexed access.
rowrotRun : [64][8] -> [64][8]
rowrotRun inb = join [ join [ leBytes w | w <- (r <<< 1) ]
                     | r <- split`{4} [ leWord w | w <- split`{16} inb ] ]

// STAGGER: rotate row r left by r. This is what turns the diagonal round into
// another column round. Applying it four times is the identity, which is how
// the block function undoes it.
staggerRun : [64][8] -> [64][8]
staggerRun inb = join [ join [ leBytes w | w <- (r <<< n) ]
                      | r <- split`{4} [ leWord w | w <- split`{16} inb ]
                      | n <- [0,1,2,3] : [4][8] ]

// One double round applied to the state built from the block function's input,
// so the brainfuck can be checked a round at a time rather than only at the end.
oneDblRun : [48][8] -> [64][8]
oneDblRun inb = join [ leBytes w | w <- doubleRound st0 ]
  where
    kws = [ leWord w | w <- split`{8} (take`{32} inb) ]
    cw  = leWord (take`{4} (drop`{32} inb))
    nws = [ leWord w | w <- split`{3} (drop`{36} inb) ]
    st0 = [0x61707865, 0x3320646e, 0x79622d32, 0x6b206574] # kws # [cw] # nws

// Shift left one, the mirror of halve136Run. The bit leaving the top byte is
// dropped, which is what makes this a doubling modulo 2^136 rather than a
// widening one; mulmod136 only ever doubles values already under 2^131, so the
// bit that is dropped is always nought.
dbl136Run : [17][8] -> [17][8]
dbl136Run inb = leBytesN`{17} (leN inb << 1)
