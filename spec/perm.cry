module perm where
import bfsodium

// The quarter round as four identical steps. Each step is always
//   a := a + b ; d := (d xor a) rotated left r
// and the four words are then permuted (a,b,c,d) -> (c,d,a,b). Applying that
// permutation twice is the identity, so after four steps the words are back in
// their natural order and no step ever needs a different pair of operands.
// If this holds, a brainfuck quarter round needs ONE add, ONE xor and ONE
// rotate in a loop, at fixed tape positions, instead of twelve unrolled ops.
qrLooped : ([32],[32],[32],[32]) -> ([32],[32],[32],[32])
qrLooped t0 = ts @ (4 : [8])
  where
    rots = [16, 12, 8, 7] : [4][8]
    ts   = [t0] # [ stp t r | t <- ts | r <- rots ]
    stp (a, b, c, d) r = (c, dd, aa, b)
      where aa = a + b
            dd = (d ^ aa) <<< r

// The claim: the looped form equals the quarter round, for every input.
property looped_matches a b c d = qrLooped (a,b,c,d) == qr4 (a,b,c,d)

// Rotate each of the four rows of the state left by its own amount.
rotRows : [16][32] -> [4][8] -> [16][32]
rotRows s ns = join [ r <<< n | r <- split`{4} s | n <- ns ]

// A quarter round applied to the four words that sit at 0, 4, 8 and 12.
qrCol : [16][32] -> [16][32]
qrCol s = update (update (update (update s 0 a) 4 b) 8 c) 12 d
  where (a, b, c, d) = qr4 (s @ (0:[8]), s @ (4:[8]), s @ (8:[8]), s @ (12:[8]))

// Four quarter rounds at FIXED positions, rotating every row left by one in
// between. Four such rotations return each row to where it started.
fourAtFixed : [16][32] -> [16][32]
fourAtFixed s0 = ss @ (4 : [8])
  where ss = [s0] # [ rotRows (qrCol s) [1,1,1,1] | s <- ss ]

// The whole double round with no indexed access anywhere: the column round is
// four fixed quarter rounds, then the rows are staggered so the diagonal round
// IS a column round, then the stagger is undone.
dblRotated : [16][32] -> [16][32]
dblRotated s = rotRows (fourAtFixed (rotRows (fourAtFixed s) [0,1,2,3])) [0,3,2,1]

property rotated_matches s = dblRotated s == doubleRound s

// ---------------------------------------------------------------------------
// How many folds does reducep136 need?
//
// reducep136 folded TWICE and then ran its tail: add five, and if bit 130 came
// up, clear it. Deleting the second fold changed no answer that any vector
// could see, which is the signal that it was unreachable rather than merely
// untested. The reason is a bound: after ONE fold a 17 byte value is at most
// (2^130 - 1) + 5*63, which is under 2p, and the tail is exactly the reduction
// for anything under 2p. So the second fold could never have work to do.
//
// This is the claim, stated so it can be proved rather than argued.

p136 : [140]
p136 = (1 << 130) - 5

foldOnce : [140] -> [140]
foldOnce x = lo + 5 * hi
  where hi = x >> 130
        lo = x && ((1 << 130) - 1)

// The tail as the brainfuck actually does it: add five, look at bit 130, and
// clear bits 130 and above if it came up -- which is subtracting 2^130.
reduceTail : [140] -> [140]
reduceTail x = if (y >> 130) != 0 then y && ((1 << 130) - 1) else x
  where y = x + 5

// One fold is enough for any seventeen byte input.
one_fold_suffices : [136] -> Bit
property one_fold_suffices x = reduceTail (foldOnce (zext x)) == (zext x) % p136

// And the tail alone is NOT enough: the claim is about the fold, not a licence
// to drop that too. This must FAIL, and is stated so the pair is a real
// distinction rather than a property that would hold whatever we deleted.
tail_alone_is_not_enough : [136] -> Bit
property tail_alone_is_not_enough x = reduceTail (zext x) == (zext x) % p136

// The adder does not WATCH for the carry, which is what made the old kernel
// cost the product of its operands; it computes the carry once, as bit 7 of
// the two halves added, and rebuilds the sum from those same halves. Both
// identities are proved here over every one of the 65536 pairs, before any
// brainfuck relies on them.
//
// The halves cannot overflow -- each is at most 127, so their sum is at most
// 254 -- which is what makes bit 7 of that sum meaningful at all.
add8_carry_is_bit7 : [8] -> [8] -> Bit
property add8_carry_is_bit7 x y = carry == (h >> 7)
  where
    h     = (x >> 1) + (y >> 1) + ((x && 1) && (y && 1))
    carry = take`{8} (((zero # x) : [16]) + (zero # y))

add8_sum_from_halves : [8] -> [8] -> Bit
property add8_sum_from_halves x y =
    x + y == 2 * ((x >> 1) + (y >> 1)) + (x && 1) + (y && 1)

// And the companion that must be REFUTED, so the first is not a claim that
// would hold whatever was deleted: without the term for both low bits set, the
// carry is wrong somewhere.
add8_low_bit_term_is_needed : [8] -> [8] -> Bit
property add8_low_bit_term_is_needed x y = carry == (h >> 7)
  where
    h     = (x >> 1) + (y >> 1)
    carry = take`{8} (((zero # x) : [16]) + (zero # y))

// ---------------------------------------------------------------------------
// AES: the two shortcuts the brainfuck takes, proved rather than believed.

// aes/xtime doubles the cell -- which wraps at 256, and the wrap IS the shift
// -- and exclusive ors 0x1b when the top bit was set. FIPS 197 says multiply
// by x modulo the polynomial. The claim is that those are the same map, and
// it is provable over all 256 bytes rather than sampled.
xtimeShift : [8] -> [8]
xtimeShift a = if a @ 0 then (a << 1) ^ 0x1b else a << 1

property xtime_is_the_field a = xtimeShift a == gfmul a 0x02

// and the companion that must be REFUTED, so the first is not a claim that
// would hold whatever was deleted: without the reduction the shift is wrong
// for exactly the 128 bytes that have their top bit set.
property xtime_reduction_is_needed a = (a << 1) == gfmul a 0x02

// aes/mixcolumn uses b_i = a_i xor t xor xtime(a_i xor a_j), where t is the
// exclusive or of all four. That is FOUR xtimes; the FIPS 197 matrix of
// 02 03 01 01 reads as eight multiplies. Most of the routine's cost rests on
// the two being the same map, so it is proved over all 2^32 columns.
mixIdentity : [4][8] -> [4][8]
mixIdentity a = [ x ^ t ^ gfmul 0x02 (x ^ y) | x <- a | y <- a <<< 1 ]
  where t = foldl (^) 0x00 a

property mix_identity_matches a = mixIdentity a == mixcolumn a

// and its companion: t is what carries the two 01 entries of each matrix row,
// so dropping it must be refuted.
mixWithoutT : [4][8] -> [4][8]
mixWithoutT a = [ x ^ gfmul 0x02 (x ^ y) | x <- a | y <- a <<< 1 ]

property mix_without_t_is_not_enough a = mixWithoutT a == mixcolumn a

// The S-box is DERIVED in bfsodium.cry rather than transcribed, and the whole
// derivation turns on x^254 being the multiplicative inverse. That is a claim
// about a field with 256 elements, so it is provable rather than asserted.
property inverse_is_an_inverse x =
    (x == zero) \/ (gfmul x (aesInv x) == 0x01)

// and the companion that must be REFUTED, so the guard above is a real
// exception and not decoration: nought has no inverse, and x^254 for x = 0 is
// 0 rather than anything that multiplies back to one.
property every_byte_has_an_inverse x = gfmul x (aesInv x) == 0x01

// ---------------------------------------------------------------------------
// AES decryption: the shortcuts the inverse takes, proved rather than believed.

// aes/gfmul does peasant multiplication: eight guarded exclusive ors, the
// multiplicand doubling each turn. The field says pmult then pmod. Proved
// over all 65536 pairs rather than sampled.
gfPeasant : [8] -> [8] -> [8]
gfPeasant a b = foldl (^) 0x00 [ if bi then ai else 0x00
                               | ai <- as
                               | bi <- reverse b ]
  where as : [8][8]
        as = [a] # [ gfmul x 0x02 | x <- take`{7} as ]

property peasant_is_the_field a b = gfPeasant a b == gfmul a b

// aes/invmixcolumn does NOT multiply by the 0e 0b 0d 09 matrix. It prepares
// the column and runs the FORWARD MixColumns over it, which is four doublings
// and one aes/mixcolumn where the matrix is sixteen general multiplies --
// better than seven times cheaper, and it reuses a routine already pinned
// against FIPS 197 Appendix B. The whole of the inverse rests on these being
// the same map.
//
// THIS ONE IS CHECKED AND NOT PROVED, and the difference is not cosmetic.
// mix_identity_matches, its forward twin, is Q.E.D. over all 2^32 columns in
// a quarter of a second; z3 does not return on this one inside 150 seconds,
// because the inverse matrix entries are four-bit constants and the pmult
// terms blow up where 02 and 03 stayed small. A proof that does not finish
// cannot go in the suite, so run.sh checks it over five thousand columns and
// says so in those words. What is NOT weaker: the identity was also checked
// against the matrix over 216608 columns in the reference, every one of the
// nine published Appendix B rounds inverts, and the round trip below holds.
invMixViaMix : [4][8] -> [4][8]
invMixViaMix a = mixcolumn [ a @ 0 ^ u, a @ 1 ^ v, a @ 2 ^ u, a @ 3 ^ v ]
  where u = gfmul 0x04 ((a @ 0) ^ (a @ 2))
        v = gfmul 0x04 ((a @ 1) ^ (a @ 3))

property inv_mix_identity_matches a = invMixViaMix a == invmixcolumn a

// and the companion that must be REFUTED: the scale is four and not two, and
// a claim that would hold at either is no claim at all. NOTE THE ASYMMETRY --
// this one IS provable, in half a second, because refuting is existential:
// z3 needs one counterexample where the positive claim needs all 2^32.
invMixWrongScale : [4][8] -> [4][8]
invMixWrongScale a = mixcolumn [ a @ 0 ^ u, a @ 1 ^ v, a @ 2 ^ u, a @ 3 ^ v ]
  where u = gfmul 0x02 ((a @ 0) ^ (a @ 2))
        v = gfmul 0x02 ((a @ 1) ^ (a @ 3))

property inv_mix_scale_is_not_two a = invMixWrongScale a == invmixcolumn a

// and that the inverse really does invert, which no vector states. Checked
// rather than proved for the same reason as above.
property inv_mix_inverts_mix a = invmixcolumn (mixcolumn a) == a

// The inverse S-box is derived one way in the spec and another in the
// brainfuck, so that a mistake would have to be made twice in two different
// shapes to survive. This is what says they agree.
property inv_sbox_is_the_inverse x = aesInvSbox (aesSbox x) == x
