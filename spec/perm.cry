module perm where
import bfsodium

// The quarter round as four identical steps. Each step is always
//   a := a + b ; d := (d xor a) rotated left r
// and the four words are then permuted (a,b,c,d) -> (c,d,a,b). Applying that
// permutation twice is the identity, so after four steps the words are back in
// their natural order and no step ever needs a different pair of operands.
// If this holds, a brainfuck quarter round needs ONE add, ONE xor and ONE
// rotate in a loop, at fixed tape positions, instead of twelve unrolled ops.
qrLooped : ([32],[32],[32],[32]) -> ([32],[32],[32],[32])
qrLooped t0 = ts @ (4 : [8])
  where
    rots = [16, 12, 8, 7] : [4][8]
    ts   = [t0] # [ stp t r | t <- ts | r <- rots ]
    stp (a, b, c, d) r = (c, dd, aa, b)
      where aa = a + b
            dd = (d ^ aa) <<< r

// The claim: the looped form equals the quarter round, for every input.
property looped_matches a b c d = qrLooped (a,b,c,d) == qr4 (a,b,c,d)

// Rotate each of the four rows of the state left by its own amount.
rotRows : [16][32] -> [4][8] -> [16][32]
rotRows s ns = join [ r <<< n | r <- split`{4} s | n <- ns ]

// A quarter round applied to the four words that sit at 0, 4, 8 and 12.
qrCol : [16][32] -> [16][32]
qrCol s = update (update (update (update s 0 a) 4 b) 8 c) 12 d
  where (a, b, c, d) = qr4 (s @ (0:[8]), s @ (4:[8]), s @ (8:[8]), s @ (12:[8]))

// Four quarter rounds at FIXED positions, rotating every row left by one in
// between. Four such rotations return each row to where it started.
fourAtFixed : [16][32] -> [16][32]
fourAtFixed s0 = ss @ (4 : [8])
  where ss = [s0] # [ rotRows (qrCol s) [1,1,1,1] | s <- ss ]

// The whole double round with no indexed access anywhere: the column round is
// four fixed quarter rounds, then the rows are staggered so the diagonal round
// IS a column round, then the stagger is undone.
dblRotated : [16][32] -> [16][32]
dblRotated s = rotRows (fourAtFixed (rotRows (fourAtFixed s) [0,1,2,3])) [0,3,2,1]

property rotated_matches s = dblRotated s == doubleRound s

// ---------------------------------------------------------------------------
// How many folds does reducep136 need?
//
// reducep136 folded TWICE and then ran its tail: add five, and if bit 130 came
// up, clear it. Deleting the second fold changed no answer that any vector
// could see, which is the signal that it was unreachable rather than merely
// untested. The reason is a bound: after ONE fold a 17 byte value is at most
// (2^130 - 1) + 5*63, which is under 2p, and the tail is exactly the reduction
// for anything under 2p. So the second fold could never have work to do.
//
// This is the claim, stated so it can be proved rather than argued.

p136 : [140]
p136 = (1 << 130) - 5

foldOnce : [140] -> [140]
foldOnce x = lo + 5 * hi
  where hi = x >> 130
        lo = x && ((1 << 130) - 1)

// The tail as the brainfuck actually does it: add five, look at bit 130, and
// clear bits 130 and above if it came up -- which is subtracting 2^130.
reduceTail : [140] -> [140]
reduceTail x = if (y >> 130) != 0 then y && ((1 << 130) - 1) else x
  where y = x + 5

// One fold is enough for any seventeen byte input.
one_fold_suffices : [136] -> Bit
property one_fold_suffices x = reduceTail (foldOnce (zext x)) == (zext x) % p136

// And the tail alone is NOT enough: the claim is about the fold, not a licence
// to drop that too. This must FAIL, and is stated so the pair is a real
// distinction rather than a property that would hold whatever we deleted.
tail_alone_is_not_enough : [136] -> Bit
property tail_alone_is_not_enough x = reduceTail (zext x) == (zext x) % p136
