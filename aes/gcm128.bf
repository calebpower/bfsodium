; ============================================================ ; the subkey is the cipher on the zero block
                                                               ; the state is still clear  which IS the zero block the
                                                               ; key goes into the window the window holds the tenth
                                                               ; round key and the constant holds 0x6c  so both go
                                                               ; back before every run
  [-]>[-]>[-]>[-]>[-]>[-]>[-]>[-]>[-]
  >[-]>[-]>[-]>[-]>[-]>[-]>[-]
>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
