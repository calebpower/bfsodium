  >>>>>>>>>>>>>>>>>>>[-<<<<<<<<<<<<<<<<<<+>>>>>>>>>>>>>>>>>>   ; byte 2 of each word
  ]<<<<<<<<<<<<<<<<<<<                                         ; continued
  >>>>>>>>>>>>>>>>>>>>>>>[-<<<<<<<<<<<<<<<<<<<<<+>>>>>>>>>>>
  >>>>>>>>>>]<<<<<<<<<<<<<<<<<<<<<<<                           ; continued
