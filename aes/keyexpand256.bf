  >[-<<<<+>>>>]>[-<<<<+>>>>]>[-<<<<+>>>>]>[-<<<<+>>>>]         ; buffer bytes 108 to 111 slide
  >[-<<<<+>>>>]>[-<<<<+>>>>]>[-<<<<+>>>>]>[-<<<<+>>>>]         ; buffer bytes 112 to 115 slide
  >[-<<<<+>>>>]>[-<<<<+>>>>]>[-<<<<+>>>>]>[-<<<<+>>>>]         ; buffer bytes 116 to 119 slide
