  +++++++++++++++++++++++++++++++++++++++++++++++>>>           ; continued
  ++++++++++++++++++++>>>                                      ; invS of 0xfa is 0x14
  ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++   ; invS of 0xfb is 0x63
  +++++++++++++++++++++++++++++++++++++++++>>>                 ; continued
  ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++   ; invS of 0xfc is 0x55
  +++++++++++++++++++++++++++>>>                               ; continued
  +++++++++++++++++++++++++++++++++>>>                         ; invS of 0xfd is 0x21
  ++++++++++++>>>                                              ; invS of 0xfe is 0x0c
  ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++   ; invS of 0xff is 0x7d
  ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++   ; continued
  +++++++++                                                    ; continued
                                                               ; ASSERT ptr=786
<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<   ; home
  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<   ; continued
  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<   ; continued
  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<   ; continued
  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<   ; continued
  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<   ; continued
  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<   ; continued
  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<   ; continued
  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<   ; continued
  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<   ; continued
  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<   ; continued
  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<   ; continued
  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<   ; continued
  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<                               ; continued
                                                               ; ASSERT ptr=0
  ++++++++++++++++                                             ; sixteen bytes to do
                                                               ; ASSERT ptr=0

; ============================================================ ; one byte a turn  sixteen turns
  [-
  >>[->>>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<<<]<<                   ; the byte under the read point goes to the walker
  >>>>>>>>>>>>>>>>>>>                                          ; and the walk fetches its entry
  [->>>+<<<]
>>>
                                                               ; ASSERT ptr=22
                                                               ; THE INDEXED WALK  entered at group 1's walker with
                                                               ; the index in it; the tape is groups of three  (d a b)
                                                               ; and the answer comes to rest in group 0's walker; the
                                                               ; caller owns the two lines that put the index there
                                                               ; and its own contract  because a pointer assertion
                                                               ; belongs to the file being assembled;
;
                                                               ; THIS IS WHY AES CANNOT BE PASTED; the walk advances
                                                               ; three cells a turn  so no loop here is pointer
                                                               ; balanced  so tools/bffoot will not bound it and
                                                               ; tools/bfexpand will not paste a file holding it; an
                                                               ; INCLUDE does not care and that is the whole reason
                                                               ; this is a block; the walk out: spend one step  carry
                                                               ; what is left to the next group  drop a trail  and
                                                               ; step on; a walk of nought stops where it starts
  [-[->>>+<<<]>+<>>>]
                                                               ; the datum is COPIED into the walker and put back from
                                                               ; the trail cell  which is nought in this group because
                                                               ; the walk stopped before setting it; that is what
                                                               ; leaves the table fit to be read again
  <[->+>+<<]>>[-<<+>>]<
                                                               ; the walk back: hand the value down one group  then
                                                               ; follow the trail while it is set  clearing it; group
                                                               ; 0's trail is never set and that is what stops the
                                                               ; walk
  [-<<<+>>>]<<[-<[-<<<+>>>]<<]
  <                                                            ; and the value has come to rest in group 0's walker
                                                               ; ASSERT ptr=19
  <<<<<<<<<<<<<<<<<<<
  >>>>>>>>>>>>>>>>>>>[-<<<<<<<<<<<<<<<<<+>>>>>>>>>>>>>>>>>]<   ; the entry comes back over the byte that indexed it
  <<<<<<<<<<<<<<<<<<                                           ; continued
  >>                                                           ; and the run turns  bringing the next byte under the
                                                               ; read point
                                                               ; ROTATE SIXTEEN  entered at the first byte of a
                                                               ; sixteen byte run with one free cell immediately below
                                                               ; it; every byte moves down one place and the first
                                                               ; wraps round to the top; the pointer comes back where
                                                               ; it started;
;
                                                               ; THIS IS THE CONVEYOR  and it is how a loop reaches
                                                               ; sixteen bytes without an index: turn the run instead
                                                               ; of walking to it  and the byte under the fixed read
                                                               ; point is a different one each turn; sixteen turns put
                                                               ; the run back as it was;
;
                                                               ; IT IS AFFORDABLE HERE AND NOWHERE NEAR A TABLE; one
                                                               ; turn of sixteen cells measures 12 thousand 314
                                                               ; instructions on FIPS 197 Appendix B's round one
                                                               ; state; In aes/subbytes the loop machinery  this
                                                               ; turning plus the two seventeen cell byte moves that
                                                               ; feed the walk  costs 324 thousand for a pass of
                                                               ; sixteen against the 4 million 750 thousand of the
                                                               ; walks it enables: six point eight percent;
;
                                                               ; THE FILE CAME OUT SIX POINT FOUR PERCENT DEARER AND
                                                               ; NOT SIX POINT EIGHT and the gap between those two
                                                               ; numbers is the whole reason this paragraph names
                                                               ; both; the looped cut of aes/subbytes also swapped a
                                                               ; PACKED ABSOLUTE table for block/sbox256's delta coded
                                                               ; one  which is 17 thousand instructions cheaper on its
                                                               ; own  so the net against the unrolled file is 307
                                                               ; thousand where the loop machinery alone is 324
                                                               ; thousand; Quoting the net as the cost of the turning
                                                               ; would credit the conveyor with a saving that belongs
                                                               ; to the table;
;
                                                               ; THAT SHARE IS NOT A CONSTANT AND THIS COMMENT WOULD
                                                               ; LIE IF IT SAID SO; a turn's cost tracks the byte
                                                               ; values it carries  79 instructions on a run of nought
                                                               ; and 29 thousand 404 on a run of 0xff  while a walk's
                                                               ; tracks the index it walks to; So the share runs from
                                                               ; four point one percent on a state of 0xff to worse
                                                               ; than double on a state of nought  where every walk
                                                               ; stops at the first group and there is nothing for the
                                                               ; turning to amortise; The figure above is quoted at a
                                                               ; published state because real states are not nought;
;
                                                               ; One turn of a 256 cell table costs about as much as a
                                                               ; whole walk  which is why the table is walked and only
                                                               ; the state is turned; HANDOFF carries the
                                                               ; measurements; the first byte drops into the free cell
                                                               ; below the run
  [-<+>]
  >[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]     ; and every other byte moves down one place
  >[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]
                                                               ; the pointer is on the last byte now  and the one that
                                                               ; dropped out comes back round to fill it
  <<<<<<<<<<<<<<<<
  [->>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<<]
  >>>>>>>>>>>>>>>>
  <<<<<<<<<<<<<<<                                              ; and home to the first byte
  <<
                                                               ; ASSERT ptr=0
  ]
                                                               ; ASSERT ptr=0
                                                               ; ASSERT zero 0:1
                                                               ; ASSERT zero 18:20

; emit
>>                                                             ; the sixteen bytes of the state  in the order they
                                                               ; were read
  .>.>.>.>.>.>.>.>.>.>.>.>.>.>.>.
