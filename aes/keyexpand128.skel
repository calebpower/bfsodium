  R29[-R12+R5+L17]R17[-L17+R17]L46
  R30[-R12+R4+L16]R16[-L16+R16]L46
  R31[-R12+R3+L15]R15[-L15+R15]L46
  R32[-R12+R2+L14]R14[-L14+R14]L46
