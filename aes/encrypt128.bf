; ============================================================ ; round 4
                                                               ; the schedule's four words for this round  computed
                                                               ; here so that nothing ever holds a hundred and seventy
                                                               ; six bytes word 16: temp is w at i minus 1  from slot
                                                               ; 3
  >>>>>>>>>>>>[->>>>>>>>>>>>>>>>>>>>>>>>>>>>>+>>>>>+<<<<<<<<
