  ------------->>>                                             ; invS of 0x0d is 0xf3
  ----------------------------------------->>>                 ; invS of 0x0e is 0xd7
  ----->>>                                                     ; invS of 0x0f is 0xfb
  ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++   ; invS of 0x10 is 0x7c
  ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++   ; continued
