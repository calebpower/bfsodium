  [->>>>>+>+<<<<<<]
>>>>>>                                                         ; the spare hands it straight back
  [-<<<<<<+>>>>>>]
<                                                              ; and if the temp is not nought the flag goes up
  [[-]<<<+>>>]
<<<<                                                           ; now the high byte  the same way
  [->>>>+>+<<<<<]
>>>>>                                                          ; and the same hand back
  [-<<<<<+>>>>>]
<                                                              ; raising the same flag  which is why EITHER byte being
                                                               ; set is enough
  [[-]<<<+>>>]
<<<                                                            ; to the flag
