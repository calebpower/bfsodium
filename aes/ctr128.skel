  [-]
L45
; ASSERT ptr=0
; everything below the table is now clear  which is what block/sbox256 would
; need were it run again  and which proves the slide emptied the state
; ASSERT zero 0:116

; the key is COPIED into the window  because every block wants it again
R885
%%block/copy16%% 885
; ASSERT ptr=900
L884
