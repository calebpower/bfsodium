; to the kernel base  which is where a paste site always stands
R7
; ASSERT ptr=17
@@ADD8@@ 17
; ASSERT ptr=17
; the carry in is nought or one  so it takes the old kernel
L1
  [-R2+L2]
R2
; ASSERT ptr=18
  [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]
; store the sum back into a2
L1
  [-L15+R15]
; the carry out becomes the carry in for the next byte
R2
