; WHICH CASE  for a 32 bit x already read into @0x00 to @0x03 big endian;
; the highest byte that is not nought decides how many bytes the encoding
; needs  and this leaves a one hot flag for that case with x untouched;
;
; THERE IS NO INDEX IN IT; four fixed tests  highest byte first  each one
; clearing the flags below it; That is why keccak/leftenc and
; keccak/rightenc are PASTEABLE where a table read would not be;
;
; IT IS THE WHOLE OF WHAT THE TWO ENCODINGS AGREE ON; SP 800_185 writes
; left_encode with the count BEFORE the bytes and right_encode with it
; AFTER  and that placement is the only difference between the two files;
; Everything up to choosing the case is this block;
;
; the caller owns the read prologue and the four case bodies below;

; ==== which case: the highest byte that is not nought decides ====
; byte 3
; is this byte not nought
  [-R6+R1+L7]
R7
  [-L7+R7]
L1
[
  -
; then the count is 3 and no later byte may choose
L4
  [-]
  +
L1
  [-]
  +
R5
]

; byte 2
; only if no higher byte has already chosen  which the else arm says
R2
  [-]
  +
L7
  [-R5+R1+L6]
R6
  [-L6+R6]
L1
  [[-]R2[-]L2]
R2
[
  -
; is this byte not nought
L9
  [-R7+R1+L8]
R8
  [-L8+R8]
L1
[
  -
; then the count is 2 and no later byte may choose
L3
  [-]
  +
L2
  [-]
  +
R5
]
R2
]

; byte 1
; only if no higher byte has already chosen  which the else arm says
  [-]
  +
L7
  [-R5+R1+L6]
R6
  [-L6+R6]
L1
  [[-]R2[-]L2]
R2
[
  -
; is this byte not nought
L10
  [-R8+R1+L9]
R9
  [-L9+R9]
L1
[
  -
; then the count is 1 and no later byte may choose
L2
  [-]
  +
L3
  [-]
  +
R5
]
R2
]

; and one byte is the case when nothing else chose
L3
  [-]
  +
L4
  [-R5+R1+L6]
R6
  [-L6+R6]
L1
  [[-]L1[-]R1]
