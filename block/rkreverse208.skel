; the low one goes to the scratch  byte 11
  R1[-R208+L208]R1[-R208+L208]R1[-R208+L208]R1[-R208+L208]
; the low one goes to the scratch  byte 15
  R1[-R208+L208]R1[-R208+L208]R1[-R208+L208]R1[-R208+L208]
; the high one comes down  byte 3
  R177[-L192+R192]R1[-L192+R192]R1[-L192+R192]R1[-L192+R192]
; the high one comes down  byte 7
  R1[-L192+R192]R1[-L192+R192]R1[-L192+R192]R1[-L192+R192]
; the high one comes down  byte 11
  R1[-L192+R192]R1[-L192+R192]R1[-L192+R192]R1[-L192+R192]
; the high one comes down  byte 15
  R1[-L192+R192]R1[-L192+R192]R1[-L192+R192]R1[-L192+R192]
; and the scratch goes up  byte 3
  R1[-L16+R16]R1[-L16+R16]R1[-L16+R16]R1[-L16+R16]
; and the scratch goes up  byte 7
  R1[-L16+R16]R1[-L16+R16]R1[-L16+R16]R1[-L16+R16]
