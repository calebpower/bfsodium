  R234[-R10+L10]R10[-R3+L3]R3[-[->>>+<<<]>+<>>>]<[->+>+<<]>>[-<<+>>]<[-<<<+>>>]<<[-<[-<<<+>>>]<<]<[-L10+R10]L244
