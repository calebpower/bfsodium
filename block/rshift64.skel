; RIGHT SHIFT ONE BIT  across a 64 bit little endian word at @0x00 to @0x07
; with the halving frame above it; every byte is halved and the bit that fell
; off it is carried into the top bit of the byte below  so the word comes out
; shifted right by one;
;
; THE BIT THAT FELL OUT OF BYTE 0 IS LEFT IN c0 FOR THE CALLER; that single
; bit is the only thing a rotate and a shift disagree about; idiom/rotr64
; adds it back as the top bit of w7 and idiom/shr64 clears it; everything
; else the two files do is this block;
;
; IT IS block/rshift32 AT TWICE THE WIDTH and not a loop over it: the carries
; run between ADJACENT bytes  so a 32 bit pass over the low half would carry
; the wrong bit into byte 4; The two widths are two files for the same reason
; the two directions are  an include takes no parameters;
;
; A HALVED BYTE IS AT MOST 127  so adding 128 to it cannot overflow and no
; second pass is needed;
;
; the caller owns the loop: this is one step of it  and the caller's own
; contract says where the pointer stands;
; one step consumed
  -

; ____ halve byte 0 @0x00  its low bit into c0 @0x09 ____
; the byte steps into the halving frame
L8
  [-R17+L17]
R17
; ASSERT ptr=+17
  [->>>+<[-<+>>-<]>[-<+>]<<<]
; the half goes back as the byte
R1
  [-L18+R18]
; and the bit that fell off is kept
R1
  [-L10+R10]
; back to the step counter
L11
; ASSERT ptr=+8

; ____ halve byte 1 @0x01  its low bit into c1 @0x0a ____
; the byte steps into the halving frame
L7
  [-R16+L16]
R16
; ASSERT ptr=+17
  [->>>+<[-<+>>-<]>[-<+>]<<<]
; the half goes back as the byte
R1
  [-L17+R17]
; and the bit that fell off is kept
R1
  [-L9+R9]
; back to the step counter
L11
; ASSERT ptr=+8

; ____ halve byte 2 @0x02  its low bit into c2 @0x0b ____
; the byte steps into the halving frame
L6
  [-R15+L15]
R15
; ASSERT ptr=+17
  [->>>+<[-<+>>-<]>[-<+>]<<<]
; the half goes back as the byte
R1
  [-L16+R16]
; and the bit that fell off is kept
R1
  [-L8+R8]
; back to the step counter
L11
; ASSERT ptr=+8

; ____ halve byte 3 @0x03  its low bit into c3 @0x0c ____
; the byte steps into the halving frame
L5
  [-R14+L14]
R14
; ASSERT ptr=+17
  [->>>+<[-<+>>-<]>[-<+>]<<<]
; the half goes back as the byte
R1
  [-L15+R15]
; and the bit that fell off is kept
R1
  [-L7+R7]
; back to the step counter
L11
; ASSERT ptr=+8

; ____ halve byte 4 @0x04  its low bit into c4 @0x0d ____
; the byte steps into the halving frame
L4
  [-R13+L13]
R13
; ASSERT ptr=+17
  [->>>+<[-<+>>-<]>[-<+>]<<<]
; the half goes back as the byte
R1
  [-L14+R14]
; and the bit that fell off is kept
R1
  [-L6+R6]
; back to the step counter
L11
; ASSERT ptr=+8

; ____ halve byte 5 @0x05  its low bit into c5 @0x0e ____
; the byte steps into the halving frame
L3
  [-R12+L12]
R12
; ASSERT ptr=+17
  [->>>+<[-<+>>-<]>[-<+>]<<<]
; the half goes back as the byte
R1
  [-L13+R13]
; and the bit that fell off is kept
R1
  [-L5+R5]
; back to the step counter
L11
; ASSERT ptr=+8

; ____ halve byte 6 @0x06  its low bit into c6 @0x0f ____
; the byte steps into the halving frame
L2
  [-R11+L11]
R11
; ASSERT ptr=+17
  [->>>+<[-<+>>-<]>[-<+>]<<<]
; the half goes back as the byte
R1
  [-L12+R12]
; and the bit that fell off is kept
R1
  [-L4+R4]
; back to the step counter
L11
; ASSERT ptr=+8

; ____ halve byte 7 @0x07  its low bit into c7 @0x10 ____
; the byte steps into the halving frame
L1
  [-R10+L10]
R10
; ASSERT ptr=+17
  [->>>+<[-<+>>-<]>[-<+>]<<<]
; the half goes back as the byte
R1
  [-L11+R11]
; and the bit that fell off is kept
R1
  [-L3+R3]
; back to the step counter
L11
; ASSERT ptr=+8

; ____ each kept bit lands as the top bit of the byte below it ____
; c1 is the top bit of w0  and the distance is ten for every one of
; c1 through c7  which is why this reads as one step repeated
R2
; ASSERT ptr=+10
; c1 is the top bit of w0
  [-L10++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++R10]
R1
; c2 is the top bit of w1
  [-L10++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++R10]
R1
; c3 is the top bit of w2
  [-L10++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++R10]
R1
; c4 is the top bit of w3
  [-L10++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++R10]
R1
; c5 is the top bit of w4
  [-L10++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++R10]
R1
; c6 is the top bit of w5
  [-L10++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++R10]
R1
; c7 is the top bit of w6
  [-L10++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++R10]
