; add the addend into the accumulator byte
R18
; ASSERT ptr=36
  [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]
; the carry in follows it
L2
  [-R2+L2]
; add that in too
R2
  [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]
; the low byte of the sum goes back where it came from
L1
  [-L34+R34]
; the carry out becomes the carry in of the byte above
R2
  [-L3+R3]
L3

