; the top byte steps into the halving frame
  [-R59+L59]
R59
; ASSERT ptr=75
  [->>>+<[-<+>>-<]>[-<+>]<<<]
; bit 128 is worth one below the split
R2
; ASSERT ptr=77
  [-L61+R61]
; and the half is halved again
L1
  [-L1+R1]
L1
; ASSERT ptr=75
  [->>>+<[-<+>>-<]>[-<+>]<<<]
; bit 129 is worth two
R2
; ASSERT ptr=77
