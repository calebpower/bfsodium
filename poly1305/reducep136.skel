  [-R48+R32+L80]
; the next byte
R1
  [-R48+R32+L80]
; the next byte
R1
  [-R48+R32+L80]
; the next byte
R1
  [-R48+R32+L80]
; the temps hand the value straight back
R64
; ASSERT ptr=80
  [-L80+R80]
; the next byte
R1
  [-L80+R80]
; the next byte
R1
  [-L80+R80]
; the next byte
R1
  [-L80+R80]
