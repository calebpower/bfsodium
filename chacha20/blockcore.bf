; y := x  x restored
  >>>>>>>>> [->+>>+<<<] >>>[-<<<+>>>] <<<
; ADD8 y into x
  > [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]
; store x into w0
  < [-<<<<<<<<<+>>>>>>>>>]
; carry into c0
  >> [-<<<<<<+>>>>>>]
