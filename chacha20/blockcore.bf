  > [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]
; store x into w3
  < [-<<<<<<+>>>>>>]
; carry into c3
  >> [-<<<+>>>]
; back to n
  <<<<<<<

