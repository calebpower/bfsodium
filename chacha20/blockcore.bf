; ADD8 y into x
  > [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]
; store x into w1
  < [-<<<<<<<<+>>>>>>>>]
; carry into c1
  >> [-<<<<<+>>>>>]
; back to n
  <<<<<<<

; ____ double byte 2 @0x02  carry into c2 @0x07 ____
