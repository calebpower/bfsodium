  >>>> [-<<<<<<<<+>>>>>>>>]
; w1 gets c0
  <<< [-<<<<+>>>>]
; w2 gets c1
  > [-<<<<+>>>>]
; w3 gets c2
  > [-<<<<+>>>>]
