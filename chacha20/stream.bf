; move cin into y
  << [->>+<<]
; ADD8 cin into x
  >> [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]
; store x into a1
  < [-<<<<<<<<+>>>>>>>>]
; carry c into cin
  >> [-<<<+>>>]
; back to cin
  <<<

