  >> [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]
; store x into a2
  < [-<<<<<<<+>>>>>>>]
; carry c into cin
  >> [-<<<+>>>]
; back to cin
  <<<

