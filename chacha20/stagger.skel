; bfsodium STAGGER : rotate row r of a ChaCha20 state left by r
;
; HAND WRITTEN; this is what turns the diagonal round into another column
; round: with the rows staggered by nought one two three  the four diagonal
; quarter rounds land on the same four words the column ones did  so the
; quarter round is pasted once and never reached through an index;
; applying a stagger four times is the identity  which is how it is undone;
;
; INTERFACE entry=63 exit=0 footprint=0:71
;
; IO  in:  state{64}   sixteen words of four little endian bytes  row major
;     out: state{64}   row r rotated left by r
;
; TAPE MAP  (home @0)
;   @0x00:0x3f  state{16}  u32 LE  four rows of four words
;   @0x40:0x47  temp{8}    u8      words in transit; EIGHT cells and not four:
;                                  row 2 exchanges the row's two halves  and
;                                  stages all eight of their bytes at once;
;                                  This file declared four for a while; Alone
;                                  that is invisible because 68 to 71 are free
;                                  zeros  but the block function had parked its
;                                  saved copy of the original state at @0x44
;                                  and one word of every block came out with
;                                  the ASCII of expand added to it; tools/bffoot
;                                  now checks this line against the code;
;
; Row 0 does not move; row 1 rotates left one  the same shape as rowrot;
; row 2 rotates left two  which is an exchange of the row's two halves;
; row 3 rotates left three  which is a rotate RIGHT by one  so its last word
; steps aside and the others slide up  walked from the top so nothing is
; overwritten before it has moved;
; read the state
  ,>,>,>,>,>,>,>,>,>,>,>,>,>,>,>,>,
; continued
  >,>,>,>,>,>,>,>,>,>,>,>,>,>,>,>,
; continued
  >,>,>,>,>,>,>,>,>,>,>,>,>,>,>,>,
; continued
  >,>,>,>,>,>,>,>,>,>,>,>,>,>,>,
; to the start of the state
L63
; ASSERT ptr=+0

; ==== row 1 rotates left one ====
R16
; ASSERT ptr=+16
; the first word steps aside
  [-R48+L48]
; the next byte
R1
  [-R48+L48]
; the next byte
R1
  [-R48+L48]
; the next byte
R1
  [-R48+L48]
; the other three slide down
R1
  [-L4+R4]
; the next byte
R1
  [-L4+R4]
; the next byte
R1
  [-L4+R4]
; the next byte
R1
  [-L4+R4]
; the next byte
R1
  [-L4+R4]
; the next byte
R1
  [-L4+R4]
; the next byte
R1
  [-L4+R4]
; the next byte
R1
  [-L4+R4]
; the next byte
R1
  [-L4+R4]
; the next byte
R1
  [-L4+R4]
; the next byte
R1
  [-L4+R4]
; the next byte
R1
  [-L4+R4]
; the temp becomes the last word
R33
; ASSERT ptr=+64
  [-L36+R36]
; the next byte
R1
  [-L36+R36]
; the next byte
R1
  [-L36+R36]
; the next byte
R1
  [-L36+R36]
L67
; ASSERT ptr=+0

; ==== row 2 rotates left two  its halves change places ====
R32
; ASSERT ptr=+32
; byte 0 of the half exchange
  [-R32+L32]
R8
  [-L8+R8]
R24
  [-L24+R24]
L32
R1
; byte 1 of the half exchange
  [-R32+L32]
R8
  [-L8+R8]
R24
  [-L24+R24]
L32
R1
; byte 2 of the half exchange
  [-R32+L32]
R8
  [-L8+R8]
R24
  [-L24+R24]
L32
R1
; byte 3 of the half exchange
  [-R32+L32]
R8
  [-L8+R8]
R24
  [-L24+R24]
L32
R1
; byte 4 of the half exchange
  [-R32+L32]
R8
  [-L8+R8]
R24
  [-L24+R24]
L32
R1
; byte 5 of the half exchange
  [-R32+L32]
R8
  [-L8+R8]
R24
  [-L24+R24]
L32
R1
; byte 6 of the half exchange
  [-R32+L32]
R8
  [-L8+R8]
R24
  [-L24+R24]
L32
R1
; byte 7 of the half exchange
  [-R32+L32]
R8
  [-L8+R8]
R24
  [-L24+R24]
L32
L39
; ASSERT ptr=+0

; ==== row 3 rotates left three  which is a rotate right by one ====
R60
; ASSERT ptr=+60
; the LAST word steps aside
  [-R4+L4]
; the next byte
R1
  [-R4+L4]
; the next byte
R1
  [-R4+L4]
; the next byte
R1
  [-R4+L4]
; the other three slide up  walked from the top so nothing is overwritten
L4
  [-R4+L4]
; the byte below
L1
  [-R4+L4]
; the byte below
L1
  [-R4+L4]
; the byte below
L1
  [-R4+L4]
; the byte below
L1
  [-R4+L4]
; the byte below
L1
  [-R4+L4]
; the byte below
L1
  [-R4+L4]
; the byte below
L1
  [-R4+L4]
; the byte below
L1
  [-R4+L4]
; the byte below
L1
  [-R4+L4]
; the byte below
L1
  [-R4+L4]
; the byte below
L1
  [-R4+L4]
; ASSERT ptr=+48
; the temp becomes the first word
R16
; ASSERT ptr=+64
  [-L16+R16]
; the next byte
R1
  [-L16+R16]
; the next byte
R1
  [-L16+R16]
; the next byte
R1
  [-L16+R16]
L67
; ASSERT ptr=+0

; emit the staggered state
  .>.>.>.>.>.>.>.>.>.>.>.>.>.>.>.>.
; continued
  >.>.>.>.>.>.>.>.>.>.>.>.>.>.>.>.
; continued
  >.>.>.>.>.>.>.>.>.>.>.>.>.>.>.>.
; continued
  >.>.>.>.>.>.>.>.>.>.>.>.>.>.>.
