; ==== byte 0 : a @0x00  b @0x04 ====
  <<<<<<<< [->>>>>>>>>+<<<<<<<<<]                              ; move a0 into x
  >>>> [->>>>>>+<<<<<<]                                        ; move b0 into y
  >>>>>> [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]      ; ADD8 y into x
  << [->>+<<]                                                  ; move cin into y
  >> [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]          ; ADD8 cin into x
  < [-<<<<<<<<<+>>>>>>>>>]                                     ; store x into a0
  >> [-<<<+>>>]                                                ; carry c into cin
  <<<                                                          ; back to cin

; ==== byte 1 : a @0x01  b @0x05 ====
  <<<<<<< [->>>>>>>>+<<<<<<<<]                                 ; move a1 into x
  >>>> [->>>>>+<<<<<]                                          ; move b1 into y
  >>>>> [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]       ; ADD8 y into x
  << [->>+<<]                                                  ; move cin into y
  >> [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]          ; ADD8 cin into x
  < [-<<<<<<<<+>>>>>>>>]                                       ; store x into a1
  >> [-<<<+>>>]                                                ; carry c into cin
  <<<                                                          ; back to cin

; ==== byte 2 : a @0x02  b @0x06 ====
  <<<<<< [->>>>>>>+<<<<<<<]                                    ; move a2 into x
  >>>> [->>>>+<<<<]                                            ; move b2 into y
  >>>> [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]        ; ADD8 y into x
  << [->>+<<]                                                  ; move cin into y
  >> [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]          ; ADD8 cin into x
  < [-<<<<<<<+>>>>>>>]                                         ; store x into a2
  >> [-<<<+>>>]                                                ; carry c into cin
  <<<                                                          ; back to cin

; ==== byte 3 : a @0x03  b @0x07 ====
  <<<<< [->>>>>>+<<<<<<]                                       ; move a3 into x
  >>>> [->>>+<<<]                                              ; move b3 into y
  >>> [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]         ; ADD8 y into x
  << [->>+<<]                                                  ; move cin into y
  >> [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]          ; ADD8 cin into x
  < [-<<<<<<+>>>>>>]                                           ; store x into a3
  >> [-<<<+>>>]                                                ; carry c into cin
  <<<                                                          ; back to cin (dropped)
