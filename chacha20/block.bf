  > [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]      ; ADD8 y into x
  < [-<<<<<<<+>>>>>>>]                                    ; store x into w2
  >> [-<<<<+>>>>]                                         ; carry into c2
  <<<<<<<                                                 ; back to n

  ; ____ double byte 3 @0x03  carry into c3 @0x08 ____
  < [->>>>>>+<<<<<<]                                      ; move w3 into x
  >>>>>> [->+>>+<<<] >>>[-<<<+>>>] <<<                    ; y := x  x restored
  > [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]      ; ADD8 y into x
  < [-<<<<<<+>>>>>>]                                      ; store x into w3
  >> [-<<<+>>>]                                           ; carry into c3
  <<<<<<<                                                 ; back to n

  ; ____ feed the carries around the cycle ____
  >>>> [-<<<<<<<<+>>>>>>>>]                               ; w0 gets c3
  <<< [-<<<<+>>>>]                                        ; w1 gets c0
  > [-<<<<+>>>>]                                          ; w2 gets c1
  > [-<<<<+>>>>]                                          ; w3 gets c2
  <<<                                                     ; back to n
]
