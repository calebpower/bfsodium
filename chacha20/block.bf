  <<< [->>>>>>>>+<<<<<<<<]                                ; move w1 into x
  >>>>>>>> [->+>>+<<<] >>>[-<<<+>>>] <<<                  ; y := x  x restored
  > [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]      ; ADD8 y into x
  < [-<<<<<<<<+>>>>>>>>]                                  ; store x into w1
  >> [-<<<<<+>>>>>]                                       ; carry into c1
  <<<<<<<                                                 ; back to n

  ; ____ double byte 2 @0x02  carry into c2 @0x07 ____
  << [->>>>>>>+<<<<<<<]                                   ; move w2 into x
  >>>>>>> [->+>>+<<<] >>>[-<<<+>>>] <<<                   ; y := x  x restored
  > [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]      ; ADD8 y into x
  < [-<<<<<<<+>>>>>>>]                                    ; store x into w2
  >> [-<<<<+>>>>]                                         ; carry into c2
  <<<<<<<                                                 ; back to n

