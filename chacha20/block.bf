  >>>>>> [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]      ; ADD8 y into x
  << [->>+<<]                                                  ; move cin into y
  >> [-<+[>>>+>+<<<<-]>>>[<<<+>>>-]<+>>[<<->>[-]]<<<]          ; ADD8 cin into x
  < [-<<<<<<<<<+>>>>>>>>>]                                     ; store x into a0
  >> [-<<<+>>>]                                                ; carry c into cin
  <<<                                                          ; back to cin

; ==== byte 1 : a @0x01  b @0x05 ====
