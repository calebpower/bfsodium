<<                                                             ; res is stored as r0
  [-<<<<<<<<<<<<<<<<<<+>>>>>>>>>>>>>>>>>>]
<<<<<<<<<<<<<<<<<<                                             ; back to r0
                                                               ; ASSERT ptr=304
                                                               ; ASSERT zero 312:325

