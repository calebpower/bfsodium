>>>>>>>>                                                       ; y0 moves into b
  [->>>>>>>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<<<<<<]
>>>>>>>>>>>>>>>>>>>>>>>>>>>                                    ; p := 1
                                                               ; ASSERT ptr=235
  +
> ++++++++                                                     ; cnt := 8
                                                               ; ASSERT ptr=236
  [-                                                           ; ____ eight bit steps ____
  <<<<<<<<<<<< [->>>+<[-<+>>-<]>[-<+>]<<<]                     ; HALVE a  giving qa and pa
  >>>> [->>>+<[-<+>>-<]>[-<+>]<<<]                             ; HALVE b  giving qb and pb
  << [->>>>>>>+<[->-<]>[-<+>]<<<<<<<]                          ; low bit of a toggles t
  >>>> [->>>+<[->-<]>[-<+>]<<<]                                ; low bit of b toggles t
  >> [->>>[-<+>>>+<<]>>[-<<+>>]<<<<<]                          ; if t then res gets p
  <<<<<<< [-<+>]                                               ; a := qa
  >>>> [-<+>]                                                  ; b := qb
  >>>>>> [->>+<<]                                              ; p into tmp
  >> [-<<++>>]                                                 ; p := tmp doubled
  <                                                            ; back to cnt
  ]
                                                               ; ASSERT ptr=236
<<                                                             ; res is stored as r0
  [-<<<<<<<<<<<<<<<<<<+>>>>>>>>>>>>>>>>>>]
<<<<<<<<<<<<<<<<<<                                             ; back to r0
                                                               ; ASSERT ptr=216
                                                               ; ASSERT zero 224:237

