>>>>>>>>>>>>>>>>>>>>>>>>>>>                                    ; p := 1
                                                               ; ASSERT ptr=243
  +
> ++++++++                                                     ; cnt := 8
                                                               ; ASSERT ptr=244
  [-                                                           ; ____ eight bit steps ____
