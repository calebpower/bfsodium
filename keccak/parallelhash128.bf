  [->>+<<]
>>
  [-<<++>>]
<                                                              ; back to the bit counter
                                                               ; ASSERT ptr=274
]
                                                               ; ASSERT ptr=274
                                                               ; res holds the byte just built  and the weight has
                                                               ; doubled past 128 to nought; everything else the bit
                                                               ; loop touched is back where it started;
                                                               ; ASSERT zero 262:271
                                                               ; ASSERT zero 273:273
<<                                                             ; store res into r0
                                                               ; ASSERT ptr=272
  [-<<<<<<<<<<<<<<<<<<+>>>>>>>>>>>>>>>>>>]
<<<<<<<<<<<<<<<<<<                                             ; back to the head of the result
                                                               ; ASSERT ptr=254

