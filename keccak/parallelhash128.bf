; ============================================================ ; ; ; ; ; split n into the byte part and the bit part
  [->>>>>>>>>>>>>>>+<<<<<<<<<<<<<<<]                           ; n steps into the halving frame  which empties its
>>>>>>>>>>>>>>>                                                ; ; cell for what goes back
