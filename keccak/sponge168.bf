  [->>>+<[-<+>>-<]>[-<+>]<<<]
>>>>                                                           ; HALVE b  giving qb and pb
                                                               ; ASSERT ptr=266
  [->>>+<[-<+>>-<]>[-<+>]<<<]
<<                                                             ; both low bits set is the and  and only that raises t
                                                               ; ASSERT ptr=264
  [[-]>>>>[[-]>>+<<]<<<<]
>>>>                                                           ; a bit left standing on its own is cleared  which the
  [-]                                                          ; ; nesting cannot reach
