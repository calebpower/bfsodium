>>>>>>>>>>>>>>>>>>>>>>>>>>>                                    ; the weight starts at one
                                                               ; ASSERT ptr=273
  +
>                                                              ; eight bits
  ++++++++
[                                                              ; ____ one bit step ____
  -
<<<<<<<<<<<<                                                   ; HALVE a  giving qa and pa
                                                               ; ASSERT ptr=262
  [->>>+<[-<+>>-<]>[-<+>]<<<]
>>>>                                                           ; HALVE b  giving qb and pb
                                                               ; ASSERT ptr=266
  [->>>+<[-<+>>-<]>[-<+>]<<<]
<<                                                             ; both low bits set is the and  and only that raises t
