                                                               ; ASSERT ptr=528
  [-<+>]
<
                                                               ; ASSERT ptr=527
  [->>>+<[-<+>>-<]>[-<+>]<<<]                                  ; the second halving drops bit one  which is worth two
>>
                                                               ; ASSERT ptr=529
  [-<<<++>>>]
<                                                              ; and back again
                                                               ; ASSERT ptr=528
  [-<+>]
<
                                                               ; ASSERT ptr=527
  [->>>+<[-<+>>-<]>[-<+>]<<<]                                  ; the third halving drops bit two  which is worth four
>>
                                                               ; ASSERT ptr=529
  [-<<<++++>>>]
<                                                              ; and the quotient that is left is n shifted right
                                                               ; three  the byte part
                                                               ; ASSERT ptr=528
