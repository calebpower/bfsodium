  [-<+>]
>>>>>>                                                         ; the weight doubles for the next bit
                                                               ; ASSERT ptr=273
  [->>+<<]
>>
  [-<<++>>]
<                                                              ; back to the bit counter
                                                               ; ASSERT ptr=274
]
