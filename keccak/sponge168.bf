  ++++++++
>>>>>>>>>>>>>>                                                 ; the bit part is spent taking that count down  and
                                                               ; never takes it to nought
                                                               ; ASSERT ptr=356
  [-<<<<<<<<<<<<<<->>>>>>>>>>>>>>]

