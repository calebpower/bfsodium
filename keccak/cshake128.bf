  >>>> [-<+>]                                                  ; b := qb
  >>>>>> [->>+<<]                                              ; p into tmp
  >> [-<<++>>]                                                 ; p := tmp doubled
  <                                                            ; back to cnt
  ]
                                                               ; ASSERT ptr=236
<<                                                             ; res is stored as r0
  [-<<<<<<<<<<<<<<<<<<+>>>>>>>>>>>>>>>>>>]
<<<<<<<<<<<<<<<<<<                                             ; back to r0
                                                               ; ASSERT ptr=216
