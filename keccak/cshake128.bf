<<                                                             ; store res into r0
                                                               ; ASSERT ptr=272
  [-<<<<<<<<<<<<<<<<<<+>>>>>>>>>>>>>>>>>>]
<<<<<<<<<<<<<<<<<<                                             ; back to the head of the result
